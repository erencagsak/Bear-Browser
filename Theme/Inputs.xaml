<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ArcAddressBarTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="{ThemeResource ArcAddressBarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ArcAddressBarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource ArcTextPrimaryBrush}" />
        <Setter Property="Padding" Value="16,7.5,14,6.5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource ArcAccentBrush}" />
    </Style>

    <Style x:Key="ArcHeroSearchBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="Background" Value="{ThemeResource ArcAddressBarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ArcAddressBarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource ArcTextPrimaryBrush}" />
        <Setter Property="Padding" Value="20,10,48,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource ArcAccentBrush}" />
    </Style>

    <Style x:Key="ArcCompactSearchBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="{ThemeResource ArcAddressBarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ArcBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource ArcTextPrimaryBrush}" />
        <Setter Property="Padding" Value="38,7.5,14,6.5" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource ArcAccentBrush}" />
    </Style>

</ResourceDictionary>
