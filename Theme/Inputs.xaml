<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Arc / Zen Yüzen Adres Çubuğu Stili (Address Bar Pill) -->
    <Style x:Key="ArcAddressBarTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="{StaticResource ArcPillCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource ArcAddressBarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ArcAddressBarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource ArcTextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,6,12,6" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource ArcAccentBrush}" />
    </Style>

    <!-- Arc / Zen Hero Arama Kutusu Stili (New Tab Search Box) -->
    <Style x:Key="ArcHeroSearchBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="50" />
        <Setter Property="CornerRadius" Value="{StaticResource ArcPillCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource ArcAddressBarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ArcAddressBarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{ThemeResource ArcTextPrimaryBrush}" />
        <Setter Property="Padding" Value="18,10,18,10" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource ArcAccentBrush}" />
    </Style>

</ResourceDictionary>
