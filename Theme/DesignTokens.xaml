            <SolidColorBrush x:Key="ArcAddressBarFocusBorderBrush" Color="#E07A1E" />

            <SolidColorBrush x:Key="TextControlBackground" Color="#221812" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#291E16" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2E2118" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#35E07A1E" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#50E07A1E" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#E07A1E" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#D4C8BE" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#A89E96" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ArcCanvasBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ArcCanvasBorderBrush" Color="#15000000" />

            <SolidColorBrush x:Key="ArcSurfaceSubtleBrush" Color="#08000000" />
            <SolidColorBrush x:Key="ArcSurfaceDefaultBrush" Color="#10000000" />
            <SolidColorBrush x:Key="ArcSurfaceHoverBrush" Color="#18000000" />
            <SolidColorBrush x:Key="ArcSurfacePressedBrush" Color="#22000000" />
            <SolidColorBrush x:Key="ArcSurfaceCardBrush" Color="#FDFBF9" />

            <SolidColorBrush x:Key="ArcBorderSubtleBrush" Color="#12000000" />
            <SolidColorBrush x:Key="ArcBorderDefaultBrush" Color="#22000000" />
            <SolidColorBrush x:Key="ArcBorderGlowBrush" Color="#35D97706" />

            <SolidColorBrush x:Key="ArcTextPrimaryBrush" Color="#261A12" />
            <SolidColorBrush x:Key="ArcTextSecondaryBrush" Color="#665A52" />
            <SolidColorBrush x:Key="ArcTextTertiaryBrush" Color="#8C8077" />

            <SolidColorBrush x:Key="ArcAccentBrush" Color="#D97706" />
