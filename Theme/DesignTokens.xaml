<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="ArcPillCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="ArcLargeCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="ArcCanvasCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ArcCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ArcButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ArcSmallCornerRadius">6</CornerRadius>

    <x:Double x:Key="ArcHoverScale">1.03</x:Double>
    <Duration x:Key="ArcAnimationDuration">0:0:0.18</Duration>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ArcCanvasBackgroundBrush" Color="#140E0A" />
            <SolidColorBrush x:Key="ArcCanvasBorderBrush" Color="#22FFFFFF" />
            
            <SolidColorBrush x:Key="ArcSurfaceSubtleBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="ArcSurfaceDefaultBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ArcSurfaceHoverBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="ArcSurfacePressedBrush" Color="#32FFFFFF" />
            <SolidColorBrush x:Key="ArcSurfaceCardBrush" Color="#1D1510" />

            <SolidColorBrush x:Key="ArcBorderSubtleBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ArcBorderDefaultBrush" Color="#30FFFFFF" />
            <SolidColorBrush x:Key="ArcBorderGlowBrush" Color="#40E07A1E" />

            <SolidColorBrush x:Key="ArcTextPrimaryBrush" Color="#F5EDE4" />
            <SolidColorBrush x:Key="ArcTextSecondaryBrush" Color="#A89E96" />
            <SolidColorBrush x:Key="ArcTextTertiaryBrush" Color="#7A7169" />

            <SolidColorBrush x:Key="ArcAccentBrush" Color="#E07A1E" />
            <SolidColorBrush x:Key="ArcAccentHoverBrush" Color="#C86712" />
            <SolidColorBrush x:Key="ArcAccentSubtleBrush" Color="#2AE07A1E" />

            <SolidColorBrush x:Key="BearTabStripBackgroundBrush" Color="#1C140E" />
            <SolidColorBrush x:Key="BearTabStripBorderBrush" Color="#22E07A1E" />

            <SolidColorBrush x:Key="ArcAddressBarBackgroundBrush" Color="#221812" />
