            <SolidColorBrush x:Key="ArcAddressBarFocusBackgroundBrush" Color="#FAF7F2" />
            <SolidColorBrush x:Key="ArcAddressBarBorderBrush" Color="#26D97706" />
            <SolidColorBrush x:Key="ArcAddressBarFocusBorderBrush" Color="#D97706" />

            <SolidColorBrush x:Key="TextControlBackground" Color="#EFE8E0" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#E6DEC4" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FAF7F2" />
