                                <FontIcon Glyph="&#xE768;" FontSize="17" Foreground="{ThemeResource ArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="İlk Kurulum Sihirbazı" FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                <TextBlock Text="Profil, sekme yerleşimi, sık kullanılanlar ve arama motoru ayarlarını adım adım yeniden yapılandırın." FontSize="12.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="RestartOnboardingBtn" Grid.Column="2" Style="{StaticResource ArcPillButtonStyle}" Click="RestartOnboardingBtn_Click" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{ThemeResource ArcAccentBrush}" />
                                    <TextBlock Text="Sihirbazı Başlat" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="Hata Ayıklama ve Çökme Teşhisi" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" Margin="4,4,0,-12" />
                    <Border Style="{StaticResource ArcCardStyle}" Padding="20,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                                <FontIcon Glyph="&#xE7BA;" FontSize="17" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Hata ve Çökme Günlükleri" FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                <TextBlock Text="Oluşan tüm beklenmedik çökmeler, tam dosya adı ve satır numarasıyla günlüğe kaydedilir." FontSize="12.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="OpenCrashLogsBtn" Style="{StaticResource ArcPillButtonStyle}" Click="OpenCrashLogsBtn_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                                        <TextBlock Text="Günlük Klasörü" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TestCrashBtn" Style="{StaticResource ArcPillButtonStyle}" Click="TestCrashBtn_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEA39;" FontSize="13" Foreground="#EF4444" />
                                        <TextBlock Text="Crash Testi" FontSize="12" Foreground="#EF4444" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DefaultBrowserContentPanel" MaxWidth="820" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Varsayılan Tarayıcı" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                        <TextBlock Text="Bear Browser'ı web bağlantıları ve HTML belgeleri için birincil tarayıcınız yapın." FontSize="13" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource ArcCardStyle}" Padding="24,20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="18" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                                <Image Width="64" Height="64" Source="ms-appx:///Assets/Bear-Browser-Logo.jpg" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Bear Browser'ı varsayılan tarayıcı yap" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                <TextBlock Text="Web bağlantılarını, e-postalardaki linkleri ve internet sayfalarını her zaman Bear Browser ile açın." FontSize="13" Foreground="{ThemeResource ArcTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Button x:Name="MakeDefaultBrowserBtn" Grid.Column="2" VerticalAlignment="Center"
                                    Style="{StaticResource ArcAccentButtonStyle}" Padding="16,8"
                                    Click="MakeDefaultBrowserBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                                    <TextBlock Text="Varsayılan Yap" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ArcCardStyle}" Padding="18,14">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource ArcAccentBrush}" />
                                <TextBlock Text="Windows Varsayılan Uygulamalar Bilgisi" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Yukarıdaki butona bastığınızda Windows Ayarları'ndaki Varsayılan Uygulamalar sayfası açılacaktır. Bear Browser'ı seçerek varsayılan olarak belirleyebilirsiniz."
                                       FontSize="12.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="LanguagesContentPanel" MaxWidth="820" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="LanguagesTitleText" Text="Diller" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                        <TextBlock x:Name="LanguagesSubtitleText" Text="Bear Browser arayüzü ve web siteleri için görüntüleme dillerini özelleştirin." FontSize="13" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource ArcCardStyle}" Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="LanguagesPreferredCardTitle" Text="Tercih Edilen Diller" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                <TextBlock x:Name="LanguagesPreferredCardSubtitle" Text="Bear Browser kullanıcı arayüzü ve web sayfaları için görüntüleme dilini seçin." FontSize="12.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                            </StackPanel>

                            <ItemsControl x:Name="LanguagesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:LanguageItem">
                                        <Border Style="{StaticResource ArcCardStyle}" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DisplayTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                                        <Border Background="#10B981" CornerRadius="4" Padding="6,2"
                                                                Visibility="{x:Bind StatusBadgeVisibility, Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind StatusBadgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#10B981" VerticalAlignment="Center"
                                                              Visibility="{x:Bind CheckmarkVisibility, Mode=OneWay}" Margin="0,0,8,0" />
                                                    <Button Content="{x:Bind SelectButtonText}" FontSize="12" Style="{StaticResource ArcPillButtonStyle}" Padding="12,5"
                                                            Tag="{x:Bind Code}" Click="SelectLanguage_Click"
                                                            Visibility="{x:Bind SelectButtonVisibility, Mode=OneWay}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ArcCardStyle}" Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="LanguagesTranslateTitleText" Text="Web sayfalarını çevirmeyi öner" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                <TextBlock x:Name="LanguagesTranslateSubtitleText" Text="Okuyamadığınız bir dildeki web sayfalarını otomatik olarak tercih ettiğiniz dile çevirme seçeneği sunar." FontSize="12.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1" IsOn="True" VerticalAlignment="Center" Margin="0,0,-12,0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AboutContentPanel" MaxWidth="820" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <Border Style="{StaticResource ArcCardStyle}" Padding="30,26">
                        <Grid RowSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="20" Background="{ThemeResource ArcSurfaceDefaultBrush}" VerticalAlignment="Center">
                                    <Image x:Name="AboutLogoImage" Width="80" Height="80" Stretch="UniformToFill" Source="ms-appx:///Assets/Bear-Browser-Logo.jpg" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="18,0,0,0">
                                    <TextBlock Text="Bear Browser" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                    <TextBlock x:Name="VersionTextBlock" Text="Sürüm 1.0.0 (64 bit)" FontSize="13.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                </StackPanel>

                                <Button x:Name="CheckUpdatesButton" Grid.Column="2" Style="{StaticResource ArcPillButtonStyle}"
                                        VerticalAlignment="Center" Margin="24,0,0,0" Click="CheckUpdatesButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing x:Name="CheckingProgress" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                                        <FontIcon x:Name="CheckIcon" Glyph="&#xE72C;" FontSize="13" Foreground="{ThemeResource ArcAccentBrush}" />
                                        <TextBlock x:Name="CheckUpdatesText" Text="Güncelleştirmeleri denetle" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" Background="{ThemeResource ArcSurfaceDefaultBrush}" BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <Ellipse x:Name="LiveDotGlow" Fill="#10B981" Opacity="0.4" Width="16" Height="16" />
                                        <Ellipse x:Name="LiveDot" Fill="#10B981" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="StatusMessageText" Text="Bear Browser güncel • En son sürümü kullanıyorsunuz" FontSize="13" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="Güncelleme Ayarları" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" Margin="4,4,0,-12" />

                    <Border Style="{StaticResource ArcCardStyle}" Padding="20,16">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Tarayıcı açıldığında güncellemeleri otomatik denetle" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                    <TextBlock Text="Yeni bir sürüm yayınlandığında ekranın sağ üstünde bildirim kartı gösterir." FontSize="12" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                </StackPanel>

                                <ToggleSwitch x:Name="AutoCheckUpdatesToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="AutoCheckUpdatesToggle_Toggled" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource ArcBorderSubtleBrush}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Güncelleme Bildirimini Simüle Et (Test)" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                    <TextBlock Text="GitHub'a henüz sürüm yüklemeden güncelleme bildirim kartını ve indirme akışını test edin." FontSize="12" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                </StackPanel>

                                <Button x:Name="TestUpdateNotificationBtn" Grid.Column="1" Click="TestUpdateNotificationBtn_Click" Style="{StaticResource ArcPillButtonStyle}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource ArcAccentBrush}" />
                                        <TextBlock Text="Bildirimi Test Et" FontSize="12.5" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Sistem ve Motor Özellikleri" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" Margin="4,4,0,-12" />

                    <Border Style="{StaticResource ArcCardStyle}" Padding="20,16">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Web Motoru" FontSize="11" Foreground="{ThemeResource ArcTextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="Chromium (WebView2)" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Arayüz Çatısı" FontSize="11" Foreground="{ThemeResource ArcTextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="WinUI 3 • .NET 9" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="İşlemci Mimarisi" FontSize="11" Foreground="{ThemeResource ArcTextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock x:Name="ArchTextBlock" Text="64-bit (x64)" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock Text="Tasarım Mimarisi" FontSize="11" Foreground="{ThemeResource ArcTextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="Bear Design" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ArcAccentBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="6" Margin="4,8,0,0">
                        <TextBlock Text="Bu tarayıcı, Chromium açık kaynak projesi ve bağımsız topluluklar tarafından güçlendirilmiştir." 
                                   FontSize="12.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="© 2026 Bear Browser Project. Modern, Akıcı ve Gizlilik Odaklı Web Deneyimi." 
                                   FontSize="12" Foreground="{ThemeResource ArcTextSecondaryBrush}" Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>