<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bear_Browser.Controls.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Bear_Browser.Models"
    xmlns:services="using:Bear_Browser.Services"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />

            <ColumnDefinition Width="1" />

            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Canvas Grid.ColumnSpan="3" IsHitTestVisible="False">
            <Ellipse Width="600" Height="350" Canvas.Left="-150" Canvas.Top="-100" Opacity="0.05">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid Grid.Column="0" Padding="16,22,14,16" Background="{ThemeResource ArcSurfaceDefaultBrush}" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />

                <RowDefinition Height="*" />

                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="6,4,0,8">
                <Border Width="38" Height="38" CornerRadius="12"
                        Background="{ThemeResource ArcAccentBrush}"
                        BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1">
                    <FontIcon Glyph="&#xE713;" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="NavTitleText" Text="Ayarlar" FontWeight="Bold" FontSize="19" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                    <TextBlock Text="Bear Browser Tercihleri" FontSize="11" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1">
                <TextBox x:Name="SearchSettingsBox" Height="36" CornerRadius="18"
                         Background="{ThemeResource ArcAddressBarBackgroundBrush}"
                         BorderBrush="{ThemeResource ArcBorderSubtleBrush}"
                         BorderThickness="1"
                         Foreground="{ThemeResource ArcTextPrimaryBrush}"
                         Padding="36,7.5,12,6.5"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         PlaceholderText="Ayarlarda ara..."
                         TextChanged="SearchSettingsBox_TextChanged" />
                <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{ThemeResource ArcTextSecondaryBrush}"
                          HorizontalAlignment="Left" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>

            <ListView x:Name="SettingsNavList" Grid.Row="2" SelectionMode="Single"
                      SelectionChanged="SettingsNavList_SelectionChanged" Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Height" Value="42" />
                        <Setter Property="CornerRadius" Value="10" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListViewItem x:Name="ProfilesNavItem" Tag="profiles">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                            <FontIcon Glyph="&#xE77B;" FontSize="13" Foreground="{ThemeResource ArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="ProfilesNavText" Text="Profiller" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>

                <ListViewItem x:Name="PrivacyNavItem" Tag="privacy">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                            <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="PrivacyNavText" Text="Gizlilik, arama ve hizmetler" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>

                <ListViewItem x:Name="AppearanceNavItem" Tag="appearance">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                            <FontIcon Glyph="&#xE790;" FontSize="13" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="AppearanceNavText" Text="Görünüm" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>

                <ListViewItem x:Name="DefaultBrowserNavItem" Tag="defaultbrowser">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                            <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="DefaultBrowserNavText" Text="Varsayılan tarayıcı" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>

                <ListViewItem x:Name="LanguagesNavItem" Tag="languages">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                            <FontIcon Glyph="&#xF2B7;" FontSize="13" Foreground="#EC4899" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="LanguagesNavText" Text="Diller" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>

                <ListViewItem x:Name="ExtensionsNavItem" Tag="extensions">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                            <FontIcon Glyph="&#xE74C;" FontSize="13" Foreground="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="ExtensionsNavText" Text="Uzantılar" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>

                <ListViewItem x:Name="DownloadsNavItem" Tag="downloads">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                            <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="#06B6D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="DownloadsNavText" Text="İndirmeler" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>

                <ListViewItem x:Name="SystemNavItem" Tag="system">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                            <FontIcon Glyph="&#xE770;" FontSize="13" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="SystemNavText" Text="Sistem ve performans" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <Border Grid.Row="3" Background="{ThemeResource ArcSurfaceDefaultBrush}" BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="2">
                <ListView x:Name="AboutNavList" SelectionMode="Single"
                          SelectionChanged="AboutNavList_SelectionChanged" Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Height" Value="42" />
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Padding" Value="10,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListViewItem x:Name="AboutNavItem" Tag="about">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource ArcAccentSubtleBrush}">
                                <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource ArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="AboutNavText" Text="Bear Browser hakkında" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="{ThemeResource ArcBorderSubtleBrush}" />

        <ScrollViewer Grid.Column="2" Padding="44,32,44,40">
            <Grid>
                <StackPanel x:Name="ProfilesContentPanel" MaxWidth="820" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Profiller" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                        <TextBlock Text="Kullanıcı profilinizi, fotoğraflarınızı ve kayıtlı tarayıcı verilerinizi yönetin." FontSize="13" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource ArcCardStyle}" Padding="24,20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                                    Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                    BorderBrush="{ThemeResource ArcAccentBrush}" BorderThickness="2">
                                <PersonPicture x:Name="ProfileAvatarPic" Width="68" Height="68" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfileNameText" Text="Kullanıcı 1" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                    <Border Background="{ThemeResource ArcAccentSubtleBrush}" CornerRadius="12" Padding="10,2">
                                        <TextBlock Text="Aktif Profil" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ArcAccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ProfileCreatedDateText" Text="Varsayılan Yerel Profil" FontSize="12.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                            </StackPanel>

                            <Button x:Name="EditProfileBtn" Grid.Column="2" VerticalAlignment="Center"
                                    Style="{StaticResource ArcAccentButtonStyle}"
                                    Click="EditProfileBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                    <TextBlock Text="Profili Düzenle" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="Profil Verileri ve Kayıtlar" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" Margin="4,4,0,-12" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource ArcCardStyle}" Padding="16,14">
                            <StackPanel Spacing="10">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource ArcSurfaceDefaultBrush}" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="15" Foreground="{ThemeResource ArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Parolalar" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                    <TextBlock x:Name="PasswordsCountText" Text="0 adet kayıtlı parola" FontSize="11.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                </StackPanel>
                                <Button Style="{StaticResource ArcPillButtonStyle}" Padding="10,4" HorizontalAlignment="Stretch" Click="GoToPasswords_Click">
                                    <TextBlock Text="Yönet" FontSize="11.5" HorizontalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource ArcCardStyle}" Padding="16,14">
                            <StackPanel Spacing="10">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource ArcSurfaceDefaultBrush}" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE734;" FontSize="15" Foreground="Gold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Sık Kullanılanlar" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                    <TextBlock x:Name="BookmarksCountText" Text="0 adet yer imi" FontSize="11.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                </StackPanel>
                                <Button Style="{StaticResource ArcPillButtonStyle}" Padding="10,4" HorizontalAlignment="Stretch" Click="GoToFavorites_Click">
                                    <TextBlock Text="Yönet" FontSize="11.5" HorizontalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource ArcCardStyle}" Padding="16,14">
                            <StackPanel Spacing="10">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource ArcSurfaceDefaultBrush}" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE81C;" FontSize="15" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Gözatma Geçmişi" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                    <TextBlock x:Name="HistoryCountText" Text="0 adet ziyaret" FontSize="11.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                </StackPanel>
                                <Button Style="{StaticResource ArcPillButtonStyle}" Padding="10,4" HorizontalAlignment="Stretch" Click="GoToHistory_Click">
                                    <TextBlock Text="Yönet" FontSize="11.5" HorizontalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource ArcCardStyle}" Padding="18,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                                <FontIcon Glyph="&#xED25;" FontSize="16" Foreground="{ThemeResource ArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Profil Veri Klasörü" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                <TextBlock Text="Profilinizin çerez, geçmiş ve yerel ayar verilerinin saklandığı güvenli yerel klasör." FontSize="12" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource ArcPillButtonStyle}" VerticalAlignment="Center" Click="OpenProfileFolder_Click">
                                <TextBlock Text="Klasörde Göster" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PrivacyContentPanel" MaxWidth="820" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Gizlilik, Arama ve Hizmetler" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                        <TextBlock Text="İzleyicileri engelleyin, arama motorunuzu seçin ve gözatma verilerinizi kontrol edin." FontSize="13" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="İzlenme Engelleme Kalkanı" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" Margin="4,4,0,-12" />
                    <Border Style="{StaticResource ArcCardStyle}" Padding="20,18">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                                    <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Gelişmiş Reklam ve İzleyici Kalkanı" FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                    <TextBlock Text="Zararlı reklamları, gizli pencereleri ve üçüncü taraf takipçi betiklerini otomatik olarak engeller." FontSize="12.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AdBlockToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="AdBlockToggle_Toggled" />
                            </Grid>

                            <Border Background="{ThemeResource ArcSurfaceDefaultBrush}" BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Engelleme Seviyesi" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                        <TextBlock Text="Dengeli veya sıkı koruma modunu belirleyin." FontSize="11.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="AdBlockLevelCombo" Grid.Column="1" Width="180" Height="36" CornerRadius="8" SelectionChanged="AdBlockLevelCombo_SelectionChanged">
                                        <ComboBoxItem Content="Dengeli (Önerilen)" Tag="Balanced" />
                                        <ComboBoxItem Content="Sıkı (Maksimum)" Tag="Strict" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Gözatma Verilerini Temizle" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" Margin="4,4,0,-12" />
                    <Border Style="{StaticResource ArcCardStyle}" Padding="20,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                                <FontIcon Glyph="&#xE74D;" FontSize="17" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Gözatma verilerini şimdi temizle" FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                <TextBlock x:Name="ClearDataStatusText" Text="Geçmişi, indirme kayıtlarını, önbelleği ve çerezleri sıfırlayın." FontSize="12.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="ClearDataBtn" Grid.Column="2" Style="{StaticResource ArcPillButtonStyle}" VerticalAlignment="Center"
                                    Click="ClearDataBtn_Click">
                                <TextBlock Text="Verileri Temizle" FontSize="12.5" Foreground="#EF4444" />
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="Arama Tercihleri" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" Margin="4,4,0,-12" />
                    <Border Style="{StaticResource ArcCardStyle}" Padding="20,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                                <FontIcon Glyph="&#xE721;" FontSize="17" Foreground="{ThemeResource ArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Adres çubuğunda kullanılan arama motoru" FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                <TextBlock Text="Adres kutusuna yazılan arama terimlerinin yönlendirileceği varsayılan motor." FontSize="12.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="SearchEngineCombo" Grid.Column="2" Width="170" Height="36" CornerRadius="8" VerticalAlignment="Center"
                                      SelectionChanged="SearchEngineCombo_SelectionChanged">
                                <ComboBoxItem Content="Google" Tag="Google" />
                                <ComboBoxItem Content="Bing" Tag="Bing" />
                                <ComboBoxItem Content="DuckDuckGo" Tag="DuckDuckGo" />
                                <ComboBoxItem Content="Yandex" Tag="Yandex" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Text="Güvenlik ve Tercihler" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" Margin="4,4,0,-12" />
                    <Border Style="{StaticResource ArcCardStyle}" Padding="20,16">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Web sitelerine 'Beni İzleme' (Do Not Track) isteği gönder" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                    <TextBlock Text="Web sitelerine gezinme alışkanlıklarınızın kaydedilmesini istemediğinizi bildirir." FontSize="12" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DoNotTrackToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="DoNotTrackToggle_Toggled" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource ArcBorderSubtleBrush}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Parolaları kaydetmeyi öner" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                    <TextBlock Text="Giriş formlarında kullanıcı adı ve parolaların tek tıkla yerel kasaya kaydedilmesini sağlar." FontSize="12" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AskPasswordToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="AskPasswordToggle_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AppearanceContentPanel" MaxWidth="820" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Görünüm" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                        <TextBlock Text="Tarayıcının temasını, sekme düzenini, araç çubuklarını ve başlangıç sayfasını özelleştirin." FontSize="13" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="Tema Tercihi" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" Margin="4,4,0,-12" />
                    <Border Style="{StaticResource ArcCardStyle}" Padding="20,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                                <FontIcon Glyph="&#xE790;" FontSize="17" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Genel Görünüm Teması" FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                <TextBlock Text="Bear Browser'ın arayüzünde kullanılan renk modunu seçin." FontSize="12.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="2" Width="180" Height="36" CornerRadius="8" VerticalAlignment="Center"
                                      SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="Sistem Varsayılanı" Tag="System" />
