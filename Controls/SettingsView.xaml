<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bear_Browser.Controls.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Bear_Browser.Models"
    xmlns:services="using:Bear_Browser.Services"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <!-- Sol Menü Bölmesi -->
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="1" />
            <!-- Sağ İçerik Bölmesi -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SOL MENÜ -->
        <Grid Grid.Column="0" Padding="16,24,16,16" Background="{ThemeResource LayerFillColorDefaultBrush}" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="6,0,0,6">
                <Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="NavTitleText" Text="Ayarlar" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Arama Kutusu -->
            <TextBox x:Name="SearchSettingsBox" Grid.Row="1" Height="36"
                     PlaceholderText="Ayarları ara..." CornerRadius="8"
                     TextChanged="SearchSettingsBox_TextChanged" />

            <!-- Kategoriler -->
            <ListView x:Name="SettingsNavList" Grid.Row="2" SelectionMode="Single"
                      SelectionChanged="SettingsNavList_SelectionChanged" Padding="0">
                <ListViewItem x:Name="ProfilesNavItem" Tag="profiles" Height="42" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE77B;" FontSize="15" Opacity="0.8" />
                        <TextBlock x:Name="ProfilesNavText" Text="Profiller" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="PrivacyNavItem" Tag="privacy" Height="42" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE72E;" FontSize="15" Opacity="0.8" />
                        <TextBlock x:Name="PrivacyNavText" Text="Gizlilik, arama ve hizmetler" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="AppearanceNavItem" Tag="appearance" Height="42" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE790;" FontSize="15" Opacity="0.8" />
                        <TextBlock x:Name="AppearanceNavText" Text="Görünüm" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="DefaultBrowserNavItem" Tag="defaultbrowser" Height="42" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE774;" FontSize="15" Opacity="0.8" />
                        <TextBlock x:Name="DefaultBrowserNavText" Text="Varsayılan tarayıcı" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="LanguagesNavItem" Tag="languages" Height="42" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xF2B7;" FontSize="15" Opacity="0.8" />
                        <TextBlock x:Name="LanguagesNavText" Text="Diller" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="ExtensionsNavItem" Tag="extensions" Height="42" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE74C;" FontSize="15" Opacity="0.8" />
                        <TextBlock x:Name="ExtensionsNavText" Text="Uzantılar" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="DownloadsNavItem" Tag="downloads" Height="42" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE896;" FontSize="15" Opacity="0.8" />
                        <TextBlock x:Name="DownloadsNavText" Text="İndirmeler" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="SystemNavItem" Tag="system" Height="42" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE770;" FontSize="15" Opacity="0.8" />
                        <TextBlock x:Name="SystemNavText" Text="Sistem ve performans" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <!-- En Alttaki "Bear Browser Hakkında" -->
            <ListView x:Name="AboutNavList" Grid.Row="3" SelectionMode="Single"
                      SelectionChanged="AboutNavList_SelectionChanged" Padding="0">
                <ListViewItem x:Name="AboutNavItem" Tag="about" Height="42" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="AboutNavText" Text="Bear Browser hakkında" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
            </ListView>
        </Grid>

        <!-- Dikey Çizgi -->
        <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- SAĞ İÇERİK BÖLGESİ -->
        <ScrollViewer Grid.Column="2" Padding="48,36,48,36">
            <Grid>
                <!-- 1. PROFİLLER PANELİ -->
                <StackPanel x:Name="ProfilesContentPanel" MaxWidth="780" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Profiller" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Kullanıcı profilinizi, fotoğraflarınızı ve kayıtlı verilerinizi yönetin." FontSize="13" Opacity="0.7" />
                    </StackPanel>

                    <!-- Ana Profil Kartı -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="24,20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PersonPicture x:Name="ProfileAvatarPic" Width="68" Height="68" Grid.Column="0" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfileNameText" Text="Kullanıcı 1" FontSize="20" FontWeight="SemiBold" />
                                    <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="12" Padding="8,2">
                                        <TextBlock Text="Aktif Profil" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ProfileCreatedDateText" Text="Varsayılan Yerel Profil" FontSize="12" Opacity="0.6" />
                            </StackPanel>

                            <Button x:Name="EditProfileBtn" Grid.Column="2" VerticalAlignment="Center"
                                    Height="36" CornerRadius="8" Style="{ThemeResource AccentButtonStyle}"
                                    Click="EditProfileBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                    <TextBlock Text="Profili Düzenle" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="Profil Verileri ve Kayıtlar" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,-12" />

                    <!-- Parolalar Kartı -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE8D7;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Parolalar" FontSize="14" FontWeight="Medium" />
                                <TextBlock x:Name="PasswordsCountText" Text="0 adet kayıtlı parola" FontSize="12" Opacity="0.7" />
                            </StackPanel>

                            <Button Grid.Column="2" Height="34" CornerRadius="6" VerticalAlignment="Center" Click="GoToPasswords_Click">
                                <TextBlock Text="Parolaları Yönet" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Sık Kullanılanlar Kartı -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE734;" FontSize="15" Foreground="Gold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Sık Kullanılanlar" FontSize="14" FontWeight="Medium" />
                                <TextBlock x:Name="BookmarksCountText" Text="0 adet yer imi" FontSize="12" Opacity="0.7" />
                            </StackPanel>

                            <Button Grid.Column="2" Height="34" CornerRadius="6" VerticalAlignment="Center" Click="GoToFavorites_Click">
                                <TextBlock Text="Sık Kullanılanları Yönet" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Geçmiş Kartı -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE81C;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Gözatma Geçmişi" FontSize="14" FontWeight="Medium" />
                                <TextBlock x:Name="HistoryCountText" Text="0 adet ziyaret kaydı" FontSize="12" Opacity="0.7" />
                            </StackPanel>

                            <Button Grid.Column="2" Height="34" CornerRadius="6" VerticalAlignment="Center" Click="GoToHistory_Click">
                                <TextBlock Text="Geçmişi Yönet" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Profil Klasörü -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xED25;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Profil Veri Klasörü" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Profilinizin çerez, geçmiş ve yerel ayar verilerinin saklandığı klasör." FontSize="12" Opacity="0.7" />
                            </StackPanel>

                            <Button Grid.Column="2" Height="34" CornerRadius="6" VerticalAlignment="Center" Click="OpenProfileFolder_Click">
                                <TextBlock Text="Klasörde Göster" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 2. GİZLİLİK, ARAMA VE HİZMETLER PANELİ -->
                <StackPanel x:Name="PrivacyContentPanel" MaxWidth="780" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Gizlilik, Arama ve Hizmetler" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="İzleyicileri engelleyin, arama motorunuzu seçin ve gözatma verilerinizi kontrol edin." FontSize="13" Opacity="0.7" />
                    </StackPanel>

                    <!-- Reklam & İzleyici Engelleme -->
                    <TextBlock Text="İzlenme Engelleme" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,-12" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Gelişmiş Reklam ve İzleyici Kalkanı" FontSize="14" FontWeight="Medium" />
                                    <TextBlock Text="Zararlı reklamları, pop-up pencereleri ve üçüncü taraf takipçi betiklerini otomatik engeller." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AdBlockToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="AdBlockToggle_Toggled" />
                            </Grid>

                            <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="14,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Engelleme Seviyesi" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                                    <ComboBox x:Name="AdBlockLevelCombo" Grid.Column="1" Width="180" Height="34" SelectionChanged="AdBlockLevelCombo_SelectionChanged">
                                        <ComboBoxItem Content="Dengeli (Önerilen)" Tag="Balanced" />
                                        <ComboBoxItem Content="Sıkı (Maksimum)" Tag="Strict" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Gözatma Verilerini Temizleme -->
                    <TextBlock Text="Gözatma Verilerini Temizle" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,-12" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="#E81123" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Gözatma verilerini şimdi temizle" FontSize="14" FontWeight="Medium" />
                                <TextBlock x:Name="ClearDataStatusText" Text="Geçmişi, indirme kayıtlarını, önbelleği ve çerezleri sıfırlayın." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="ClearDataBtn" Grid.Column="2" Height="36" CornerRadius="6" VerticalAlignment="Center"
                                    Click="ClearDataBtn_Click">
                                <TextBlock Text="Verileri Temizle" FontSize="13" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Arama Motoru -->
                    <TextBlock Text="Arama Tercihleri" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,-12" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE721;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Adres çubuğunda kullanılan arama motoru" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Adres çubuğuna yazılan arama terimlerinin yönlendirileceği varsayılan motor." FontSize="12" Opacity="0.7" />
                            </StackPanel>
                            <ComboBox x:Name="SearchEngineCombo" Grid.Column="2" Width="160" Height="36" VerticalAlignment="Center"
                                      SelectionChanged="SearchEngineCombo_SelectionChanged">
                                <ComboBoxItem Content="Google" Tag="Google" />
                                <ComboBoxItem Content="Bing" Tag="Bing" />
                                <ComboBoxItem Content="DuckDuckGo" Tag="DuckDuckGo" />
                                <ComboBoxItem Content="Yandex" Tag="Yandex" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Diğer Gizlilik Tercihleri -->
                    <TextBlock Text="Güvenlik &amp; Tercihler" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,-12" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Web sitelerine 'Beni İzleme' (Do Not Track) isteği gönder" FontSize="14" FontWeight="Medium" />
                                    <TextBlock Text="Web sitelerine gezinme alışkanlıklarınızın kaydedilmesini istemediğinizi bildirir." FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DoNotTrackToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="DoNotTrackToggle_Toggled" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Parolaları kaydetmeyi öner" FontSize="14" FontWeight="Medium" />
                                    <TextBlock Text="Giriş formlarında kullanıcı adı ve parolaların tek tıkla kaydedilmesini sağlar." FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AskPasswordToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="AskPasswordToggle_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. GÖRÜNÜM PANELİ -->
                <StackPanel x:Name="AppearanceContentPanel" MaxWidth="780" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Görünüm" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Tarayıcının temasını, araç çubuklarını ve yakınlaştırma tercihlerini özelleştirin." FontSize="13" Opacity="0.7" />
                    </StackPanel>

                    <!-- Tema Kartı -->
                    <TextBlock Text="Tema Tercihi" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,-12" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE790;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Genel Görünüm Teması" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Bear Browser'ın arayüzünde kullanılan renk modunu seçin." FontSize="12" Opacity="0.7" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="2" Width="180" Height="36" VerticalAlignment="Center"
                                      SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="Sistem Varsayılanı" Tag="System" />
                                <ComboBoxItem Content="Koyu Tema" Tag="Dark" />
                                <ComboBoxItem Content="Açık Tema" Tag="Light" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Sık Kullanılanlar Çubuğu -->
                    <TextBlock Text="Araç Çubukları" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,-12" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="Gold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Sık kullanılanlar çubuğunu göster" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Adres çubuğunun hemen altında yer imlerinizi ve klasörlerinizi gösterin." FontSize="12" Opacity="0.7" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowFavBarToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="ShowFavBarToggle_Toggled" />
                        </Grid>
                    </Border>

                    <!-- Yakınlaştırma -->
                    <TextBlock Text="Sayfa Yakınlaştırması" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,-12" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE8A3;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Varsayılan sayfa yakınlaştırma düzeyi" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Yeni açılan tüm web sayfaları bu yakınlaştırma ölçeğiyle başlatılır." FontSize="12" Opacity="0.7" />
                            </StackPanel>
                            <ComboBox x:Name="ZoomCombo" Grid.Column="2" Width="140" Height="36" VerticalAlignment="Center"
                                      SelectionChanged="ZoomCombo_SelectionChanged">
                                <ComboBoxItem Content="%75" Tag="0.75" />
                                <ComboBoxItem Content="%90" Tag="0.9" />
                                <ComboBoxItem Content="%100" Tag="1.0" />
                                <ComboBoxItem Content="%110" Tag="1.1" />
                                <ComboBoxItem Content="%125" Tag="1.25" />
                                <ComboBoxItem Content="%150" Tag="1.5" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Giriş Sayfası -->
                    <TextBlock Text="Başlangıç Sayfası" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,-12" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Spacing="2">
                                <TextBlock Text="Yeni Sekme ve Giriş Sayfası Adresi" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Yeni sekme açıldığında otomatik yüklenecek web adresi." FontSize="12" Opacity="0.7" />
                            </StackPanel>
                            <Grid Grid.Row="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HomePageBox" Height="36" CornerRadius="6" VerticalContentAlignment="Center" />
                                <Button x:Name="SaveHomePageBtn" Grid.Column="1" Height="36" CornerRadius="6" Style="{ThemeResource AccentButtonStyle}"
                                        Click="SaveHomePageBtn_Click">
                                    <TextBlock Text="Kaydet" FontSize="13" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 4. UZANTILAR PANELİ -->
                <StackPanel x:Name="ExtensionsContentPanel" MaxWidth="780" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Uzantılar" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Tarayıcınıza yüklediğiniz eklentileri yönetin veya mağazalardan yeni uzantılar edinin." FontSize="13" Opacity="0.7" />
                    </StackPanel>

                    <!-- Mağazalar ve Hızlı Bağlantılar Kartı -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20,18">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Eklenti Mağazaları" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Google Chrome Web Mağazası ve Microsoft Edge Add-ons üzerinden milyonlarca eklentiyi tek tıkla Bear Browser'a ekleyebilirsiniz." FontSize="12" Opacity="0.7" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Height="42" HorizontalAlignment="Stretch" CornerRadius="8"
                                        Click="SettingsOpenChromeWebStore_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Chrome Web Mağazasını Aç" FontSize="13" FontWeight="Medium" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Height="42" HorizontalAlignment="Stretch" CornerRadius="8"
                                        Click="SettingsOpenEdgeAddons_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Microsoft Edge Eklentilerini Aç" FontSize="13" FontWeight="Medium" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Geliştirici Modu & Yerel Yükleme Kartı -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Geliştirici Modu" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Bilgisayarınızdaki klasörden paketlenmemiş (unpacked) uzantı yükleyin." FontSize="12" Opacity="0.7" />

                                <Button x:Name="SettingsLoadUnpackedBtn" Visibility="Collapsed" Height="34" CornerRadius="6" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Click="SettingsLoadUnpackedBtn_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                                        <TextBlock Text="Paketlenmemiş uzantı yükle..." FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ToggleSwitch x:Name="SettingsDevModeToggle" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                                          Toggled="SettingsDevModeToggle_Toggled" />
                        </Grid>
                    </Border>

                    <!-- Yüklü Eklentiler Başlık & Arama -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Yüklü Uzantılar" FontSize="18" FontWeight="SemiBold" />
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="SettingsExtensionsCountBadge" Text="0 eklenti" FontSize="12" FontWeight="Medium" Opacity="0.8" />
                            </Border>
                        </StackPanel>

                        <TextBox x:Name="SettingsExtensionSearchBox" HorizontalAlignment="Right" Width="220" Height="34" CornerRadius="6"
                                 PlaceholderText="Eklentilerde ara..." TextChanged="SettingsExtensionSearchBox_TextChanged" />
                    </Grid>

                    <!-- Boş Durum (Eklenti Yoksa) -->
                    <Border x:Name="SettingsEmptyStateBorder" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="32" HorizontalAlignment="Stretch" Visibility="Collapsed">
                        <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="440">
                            <Border Width="56" Height="56" CornerRadius="14" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE74C;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Henüz hiçbir uzantı yüklenmedi" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Chrome Web Mağazası veya Edge Add-ons üzerinden dilediğiniz eklentileri yükleyebilir, burada yönetebilirsiniz."
                                       FontSize="12" Opacity="0.75" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Uzantı Öğeleri Listesi -->
                    <ItemsControl x:Name="SettingsExtensionsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ExtensionInfo">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- İkon -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Top">
                                            <Grid>
                                                <FontIcon Glyph="&#xE74C;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{x:Bind IconPath, Mode=OneWay}" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Bilgiler -->
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Version, Mode=OneWay}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Source, Mode=OneWay}" FontSize="10" Opacity="0.75" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />

                                            <TextBlock Text="{x:Bind Id, Mode=OneWay}" FontSize="10" Opacity="0.4" FontFamily="Consolas" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Aksiyonlar: Aç/Kapa Toggle & Kaldır Butonu -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center"
                                                          Toggled="SettingsExtensionToggle_Toggled" Tag="{x:Bind Id}" />

                                            <Button Width="36" Height="36" Padding="0" CornerRadius="6"
                                                    ToolTipService.ToolTip="Uzantıyı Kaldır" Click="SettingsRemoveExtension_Click" Tag="{x:Bind Id}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#E81123" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 5. İNDİRMELER PANELİ -->
                <StackPanel x:Name="DownloadsContentPanel" MaxWidth="780" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="İndirmeler" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="İndirilen dosyalarınızın konumu ve indirme tercihleri." FontSize="13" Opacity="0.7" />
                    </StackPanel>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="24,20">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="Varsayılan İndirme Klasörü" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DownloadsPathText" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Height="36" CornerRadius="8" VerticalAlignment="Center" Click="OpenDownloadsFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                                        <TextBlock Text="Klasörü Aç" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Tüm İndirme Geçmişini Görüntüle" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Devam eden ve tamamlanan indirmelerinizi ayrıntılı sayfada yönetin." FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Height="34" CornerRadius="6" Style="{ThemeResource AccentButtonStyle}" Click="GoToDownloadsPage_Click">
                                        <TextBlock Text="İndirilenler Sayfasını Aç" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 5. SİSTEM VE PERFORMANS PANELİ (CANLI ANALİZ DASHBOARD) -->
                <StackPanel x:Name="SystemContentPanel" MaxWidth="780" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Sistem ve Performans" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Canlı bellek kullanımı, kaynak optimizasyonu ve donanım hızlandırma analizleri." FontSize="13" Opacity="0.7" />
                    </StackPanel>

                    <!-- 4'lü Canlı Metrik Göstergesi -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 1. RAM Göstergesi -->
                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,14">
                            <StackPanel Spacing="6">
                                <FontIcon Glyph="&#xE770;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="LiveRamText" Text="-- MB" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Aktif RAM Tüketimi" FontSize="11" Opacity="0.6" FontWeight="Medium" />
                            </StackPanel>
                        </Border>

                        <!-- 2. Engellenen Reklamlar -->
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,14">
                            <StackPanel Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#107C41" HorizontalAlignment="Left" />
                                <TextBlock x:Name="LiveBlockedAdsText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#107C41" />
                                <TextBlock Text="Engellenen Reklam" FontSize="11" Opacity="0.6" FontWeight="Medium" />
                            </StackPanel>
                        </Border>

                        <!-- 3. Sayfa Yanıt Süresi -->
                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,14">
                            <StackPanel Spacing="6">
                                <FontIcon Glyph="&#xE916;" FontSize="16" Foreground="#F59E0B" HorizontalAlignment="Left" />
                                <TextBlock x:Name="LiveSpeedText" Text="~280 ms" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Ortalama Sayfa Yanıtı" FontSize="11" Opacity="0.6" FontWeight="Medium" />
                            </StackPanel>
                        </Border>

                        <!-- 4. Donanım Hızlandırma -->
                        <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,14">
                            <StackPanel Spacing="6">
                                <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="#6366F1" HorizontalAlignment="Left" />
                                <TextBlock Text="D3D11" FontSize="22" FontWeight="Bold" Foreground="#6366F1" />
                                <TextBlock Text="GPU Hızlandırma" FontSize="11" Opacity="0.6" FontWeight="Medium" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bellek Optimizasyon Kartı -->
                    <TextBlock Text="Kaynak Yönetimi" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,-12" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE91B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Belleği Şimdi Optimize Et" FontSize="14" FontWeight="Medium" />
                                <TextBlock x:Name="MemoryOptimizeStatusText" Text="Arka plandaki gereksiz önbellekleri temizler ve işletim sistemine RAM iade eder." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="OptimizeMemoryBtn" Grid.Column="2" Height="36" CornerRadius="6" VerticalAlignment="Center"
                                    Style="{ThemeResource AccentButtonStyle}" Click="OptimizeMemoryBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE777;" FontSize="13" />
                                    <TextBlock Text="Belleği Temizle" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Eco-QoS / Uyku Modu -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xEC4A;" FontSize="16" Foreground="#107C41" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Arka Plan Sekmelerini Uyku Moduna Al (Eco-QoS)" FontSize="14" FontWeight="Medium" />
                                    <Border Background="#107C41" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Aktif" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Kullanılmayan sekmeleri otomatik olarak minimum CPU ve RAM moduna alarak sistem kaynaklarını ve pil ömrünü korur." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="EcoModeToggle" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" IsOn="True" Toggled="EcoModeToggle_Toggled" />
                        </Grid>
                    </Border>

                    <!-- Hata Ayıklama ve Çökme Teşhisi -->
                    <TextBlock Text="Hata Ayıklama ve Çökme Teşhisi (Crash Diagnostics)" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,-12" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="#E81123" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Hata ve Çökme Günlükleri" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Oluşan tüm beklenmedik çökmeler, tam dosya adı ve satır numarasıyla günlüğe kaydedilir." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="OpenCrashLogsBtn" Height="36" CornerRadius="6" VerticalAlignment="Center"
                                        Click="OpenCrashLogsBtn_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                                        <TextBlock Text="Günlük Klasörü" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TestCrashBtn" Height="36" CornerRadius="6" VerticalAlignment="Center"
                                        Click="TestCrashBtn_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEA39;" FontSize="13" Foreground="#E81123" />
                                        <TextBlock Text="Crash Testi Yap" FontSize="13" Foreground="#E81123" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- VARSAYILAN TARAYICI PANELİ -->
                <StackPanel x:Name="DefaultBrowserContentPanel" MaxWidth="780" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Varsayılan Tarayıcı" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Bear Browser'ı web bağlantıları ve HTML dosyaları için varsayılan tarayıcınız yapın." FontSize="13" Opacity="0.7" />
                    </StackPanel>

                    <!-- Kart -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="24,20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="16"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Image Width="64" Height="64" Source="ms-appx:///Assets/Bear-Browser-Logo.jpg" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Bear Browser'ı varsayılan tarayıcı yap" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Web bağlantılarını, e-postalardaki linkleri ve internet sayfalarını her zaman Bear Browser ile açın." FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>

                            <Button x:Name="MakeDefaultBrowserBtn" Grid.Column="2" VerticalAlignment="Center"
                                    Style="{ThemeResource AccentButtonStyle}" Padding="16,8" CornerRadius="8"
                                    Click="MakeDefaultBrowserBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                                    <TextBlock Text="Varsayılan Yap" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10" Padding="16,14">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="14" Opacity="0.8" />
                                <TextBlock Text="Windows Varsayılan Uygulamalar Bilgisi" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="Yukarıdaki butona bastığınızda Windows Ayarları'ndaki Varsayılan Uygulamalar sayfası açılacaktır. Buradan Bear Browser'ı seçerek varsayılan olarak belirleyebilirsiniz."
                                       FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- DİLLER PANELİ -->
                <StackPanel x:Name="LanguagesContentPanel" MaxWidth="780" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="LanguagesTitleText" Text="Diller" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="LanguagesSubtitleText" Text="Bear Browser arayüzü ve web siteleri için görüntüleme dillerini özelleştirin." FontSize="13" Opacity="0.7" />
                    </StackPanel>

                    <!-- Tercih Edilen Diller Kartı -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="LanguagesPreferredCardTitle" Text="Tercih Edilen Diller" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="LanguagesPreferredCardSubtitle" Text="Bear Browser kullanıcı arayüzü ve web sayfaları için görüntüleme dilini seçin." FontSize="12" Opacity="0.65" />
                            </StackPanel>

                            <!-- Dinamik Dil Listesi -->
                            <ItemsControl x:Name="LanguagesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:LanguageItem">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DisplayTitle}" FontSize="14" FontWeight="SemiBold" />
                                                        <Border Background="#107C41" CornerRadius="4" Padding="6,2"
                                                                Visibility="{x:Bind StatusBadgeVisibility, Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind StatusBadgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.6" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#107C41" VerticalAlignment="Center"
                                                              Visibility="{x:Bind CheckmarkVisibility, Mode=OneWay}" Margin="0,0,8,0" />
                                                    <Button Content="{x:Bind SelectButtonText}" FontSize="12" Padding="12,6" CornerRadius="6"
                                                            Tag="{x:Bind Code}" Click="SelectLanguage_Click"
                                                            Visibility="{x:Bind SelectButtonVisibility, Mode=OneWay}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Çeviri Kartı -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="LanguagesTranslateTitleText" Text="Web sayfalarını çevirmeyi öner" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="LanguagesTranslateSubtitleText" Text="Okuyamadığınız bir dildeki web sayfalarını otomatik olarak tercih ettiğiniz dile çevirme seçeneği sunar." FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1" IsOn="True" VerticalAlignment="Center" Margin="0,0,-12,0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 6. BEAR BROWSER HAKKINDA PANELİ -->
                <StackPanel x:Name="AboutContentPanel" MaxWidth="780" HorizontalAlignment="Left" Spacing="24" Visibility="Collapsed">
                    <!-- Yumuşak Açılış Geçişi -->
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <!-- Kahraman Kart: Logo, Başlık ve Canlı Güncelleme -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="28,24">
                        <Grid RowSpacing="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <Border Width="72" Height="72" CornerRadius="18" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <Image x:Name="AboutLogoImage" Width="72" Height="72" Stretch="UniformToFill" Source="ms-appx:///Assets/Bear-Browser-Logo.jpg" />
                                    </Border>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="Bear Browser" FontSize="26" FontWeight="SemiBold" />
                                            <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="Resmi Derleme" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="VersionTextBlock" Text="Sürüm 1.0.0 (64 bit)" FontSize="13" Opacity="0.7" />
                                    </StackPanel>
                                </StackPanel>

                                <Button x:Name="CheckUpdatesButton" Grid.Column="1" Height="38" CornerRadius="8" 
                                        VerticalAlignment="Center" Click="CheckUpdatesButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing x:Name="CheckingProgress" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                                        <FontIcon x:Name="CheckIcon" Glyph="&#xE72C;" FontSize="13" />
                                        <TextBlock x:Name="CheckUpdatesText" Text="Güncelleştirmeleri denetle" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="14,10">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <Ellipse x:Name="LiveDotGlow" Fill="#107C41" Opacity="0.4" Width="16" Height="16" />
                                        <Ellipse Fill="#107C41" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="StatusMessageText" Text="Bear Browser güncel • En son sürümü kullanıyorsunuz" FontSize="13" FontWeight="Medium" Foreground="#107C41" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="Sistem ve Motor Özellikleri" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,-12" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" CornerRadius="10" Padding="20,16">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Web Motoru" FontSize="11" Opacity="0.6" FontWeight="SemiBold" />
                                <TextBlock Text="Chromium (WebView2)" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Arayüz Çatısı" FontSize="11" Opacity="0.6" FontWeight="SemiBold" />
                                <TextBlock Text="WinUI 3 • .NET 8" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="İşlemci Mimarisi" FontSize="11" Opacity="0.6" FontWeight="SemiBold" />
                                <TextBlock x:Name="ArchTextBlock" Text="64-bit (x64)" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock Text="Bellek Yöneticisi" FontSize="11" Opacity="0.6" FontWeight="SemiBold" />
                                <TextBlock Text="Düşük Tüketim Modu" FontSize="13" FontWeight="SemiBold" Foreground="#107C41" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="8" Margin="4,8,0,0">
                        <TextBlock Text="Bu tarayıcı, Chromium açık kaynak projesi ve bağımsız açık kaynak toplulukları tarafından desteklenmektedir." 
                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                        <TextBlock Text="© 2026 Bear Browser Project. Tüm hakları saklıdır." 
                                   FontSize="12" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>