<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bear_Browser.Controls.FavoritesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bear_Browser.Controls">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="450" Height="250" Canvas.Left="-100" Canvas.Top="-50" Opacity="0.06">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <ScrollViewer Padding="36,24,36,36">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">
                <Grid ColumnSpacing="16" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12"
                                Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1">
                            <FontIcon Glyph="&#xE734;" FontSize="17" Foreground="{ThemeResource ArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <StackPanel x:Name="BreadcrumbArea" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        AllowDrop="True" DragOver="BreadcrumbArea_DragOver" Drop="BreadcrumbArea_Drop">
                                <Button x:Name="BackButton" Width="26" Height="26" Padding="0"
                                        Style="{StaticResource ArcIconButtonStyle}"
                                        Visibility="Collapsed" Click="BackButton_Click"
                                        ToolTipService.ToolTip="Geri Dön" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72B;" FontSize="11" />
                                </Button>
                                <TextBlock x:Name="BreadcrumbText" Text="Sık Kullanılanlar" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource ArcTextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="{ThemeResource ArcSurfaceDefaultBrush}" BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CountBadgeText" Text="0 yer imi" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" HorizontalAlignment="Center" Width="320" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource ArcCompactSearchBoxStyle}"
                                 PlaceholderText="Sık kullanılanlarda ara..."
                                 TextChanged="SearchBox_TextChanged" />
                        <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource ArcTextSecondaryBrush}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="AddFolderBtn" Style="{StaticResource ArcPillButtonStyle}" Click="AddFolderBtn_Click" ToolTipService.ToolTip="Yeni klasör oluştur">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xED25;" FontSize="12" Foreground="{ThemeResource ArcAccentBrush}" />
                                <TextBlock Text="Klasör Ekle" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddFavBtn" Style="{StaticResource ArcPillButtonStyle}" Click="AddFavBtn_Click" ToolTipService.ToolTip="Yeni sık kullanılan ekle">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource ArcAccentBrush}" />
                                <TextBlock Text="Ekle" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportBookmarksBtn" Style="{StaticResource ArcPillButtonStyle}" Click="ImportBookmarksBtn_Click" ToolTipService.ToolTip="HTML dosyasından içe aktar">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B5;" FontSize="12" />
                                <TextBlock Text="İçeri Aktar" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportBookmarksBtn" Style="{StaticResource ArcPillButtonStyle}" Click="ExportBookmarksBtn_Click" ToolTipService.ToolTip="HTML olarak dışa aktar">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEDE1;" FontSize="12" />
                                <TextBlock Text="Dışarı Aktar" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ToggleBarBtn" Style="{StaticResource ArcIconButtonStyle}" Width="32" Height="32" Click="ToggleBarBtn_Click" ToolTipService.ToolTip="Sık Kullanılanlar Çubuğunu Göster / Gizle">
                            <FontIcon Glyph="&#xE7B3;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ListView x:Name="ItemsListView" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="ItemsListView_ItemClick" Padding="0"
                          AllowDrop="True" DragOver="ItemsListView_DragOver" Drop="ItemsListView_Drop">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:FavoriteDisplayItem">
                            <Border Style="{StaticResource ArcCardStyle}" Padding="14,12" Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch" PointerPressed="ItemGrid_PointerPressed"
                                    CanDrag="True" AllowDrop="True"
                                    DragStarting="ItemCard_DragStarting" DragOver="ItemCard_DragOver" DragLeave="ItemCard_DragLeave" Drop="ItemCard_Drop"
                                    Tag="{x:Bind}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="260" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                            Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                            BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource ArcAccentBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{x:Bind FolderVisibility}" />
                                            <Image Width="18" Height="18" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{x:Bind FaviconVisibility}">
                                                <Image.Source>
                                                    <BitmapImage UriSource="{x:Bind FaviconUri}" />
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{ThemeResource ArcTextPrimaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="2" Text="{x:Bind Subtitle}" FontSize="12"
                                               Foreground="{ThemeResource ArcTextSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Width="32" Height="32" Padding="0" Style="{StaticResource ArcIconButtonStyle}"
                                                ToolTipService.ToolTip="Sil" Click="DeleteItem_Click" Tag="{x:Bind Tag}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#EF4444" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>