<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Bear_Browser.Controls.ProfileEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bear_Browser.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Profili Düzenle"
    PrimaryButtonText="Kaydet"
    CloseButtonText="İptal"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="16" Width="340" Margin="0,6,0,0">
        <TextBox x:Name="ProfileNameBox" 
                 Header="Profil Adı" 
                 PlaceholderText="Bir profil adı girin..." />

        <StackPanel x:Name="InitialAvatarPanel" HorizontalAlignment="Center" Spacing="10" Margin="0,6,0,0">
            <PersonPicture x:Name="AvatarPreview" Width="96" Height="96" />
            <Button HorizontalAlignment="Center" Click="SelectImageButton_Click" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEB9F;" FontSize="14" />
                    <TextBlock Text="Yeni Fotoğraf Seç..." FontSize="13" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel x:Name="CropEditorPanel" Spacing="10" Visibility="Collapsed" HorizontalAlignment="Center">
            <TextBlock Text="Fotoğrafı sürükleyip çembere göre hizalayın:" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" />

            <Grid Width="200" Height="200" HorizontalAlignment="Center"
                  PointerPressed="CropArea_PointerPressed"
                  PointerMoved="CropArea_PointerMoved"
                  PointerReleased="CropArea_PointerReleased"
                  PointerWheelChanged="CropArea_PointerWheelChanged">

                <Border x:Name="VisibleCircleCrop" Width="180" Height="180" CornerRadius="90"
                        Background="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="SourceCropImage" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.RenderTransform>
                            <CompositeTransform x:Name="ImageTransform" />
                        </Image.RenderTransform>
                    </Image>
                </Border>

                <Border Width="180" Height="180" CornerRadius="90"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2.5"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" />
            </Grid>

            <Grid Width="260" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Glyph="&#xE71F;" FontSize="13" VerticalAlignment="Center" Opacity="0.6" Grid.Column="0" Margin="0,0,8,0" />
                <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="0.5" Maximum="3.0" Value="1.0" StepFrequency="0.05"
                        ValueChanged="ZoomSlider_ValueChanged" VerticalAlignment="Center" />
                <FontIcon Glyph="&#xE71E;" FontSize="14" VerticalAlignment="Center" Opacity="0.6" Grid.Column="2" Margin="8,0,8,0" />
                <Button Grid.Column="3" Width="32" Height="32" Padding="0" CornerRadius="6"
                        Click="ResetPosition_Click" ToolTipService.ToolTip="Ortala ve Sıfırla">
                    <FontIcon Glyph="&#xE777;" FontSize="12" />
                </Button>
            </Grid>

            <Button HorizontalAlignment="Center" Click="SelectImageButton_Click" CornerRadius="6" Margin="0,2,0,0">
                <TextBlock Text="Farklı Bir Fotoğraf Seç..." FontSize="12" />
            </Button>
        </StackPanel>
    </StackPanel>
</ContentDialog>