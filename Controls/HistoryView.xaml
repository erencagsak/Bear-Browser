<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bear_Browser.Controls.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Bear_Browser.Models">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <!-- Sol Filtre Bölmesi -->
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="1" />
            <!-- Sağ Ziyaret Listesi Bölmesi -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SOL BÖLME -->
        <Grid Grid.Column="0" Padding="16,20,12,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE81C;" FontSize="18" />
                <TextBlock Text="Geçmiş" FontWeight="SemiBold" FontSize="18" />
            </StackPanel>

            <!-- Arama Kutusu -->
            <TextBox x:Name="SearchBox" Grid.Row="1" Height="34"
                     PlaceholderText="Geçmişte ara..."
                     TextChanged="SearchBox_TextChanged" />

            <!-- Zaman Filtreleri -->
            <ListView x:Name="FiltersListView" Grid.Row="2" SelectionMode="Single"
                      SelectionChanged="FiltersListView_SelectionChanged" Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,6">
                            <FontIcon Glyph="&#xE823;" FontSize="13" Opacity="0.7" />
                            <TextBlock Text="{x:Bind}" FontSize="13" FontWeight="Medium" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- SAĞ BÖLME -->
        <Grid Grid.Column="2" Padding="28,20,28,16" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Üst Bar: Başlık ve Temizle Butonu -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="CurrentFilterTitleText" Text="Tüm Geçmiş"
                           FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" />

                <Button x:Name="ClearHistoryBtn" HorizontalAlignment="Right" Padding="12,6"
                        CornerRadius="6" Click="ClearHistoryBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        <TextBlock Text="Tüm geçmişi temizle" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Geçmiş Listesi -->
            <ListView x:Name="HistoryListView" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="HistoryListView_ItemClick" Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryItem">
                        <Grid Padding="10,8" Margin="0,2" CornerRadius="6"
                              Background="{ThemeResource SubtleFillColorTransparentBrush}"
                              HorizontalAlignment="Stretch" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Web İkonu (Site Faviconu) -->
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                <Image Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind FaviconUri}" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <!-- Ziyaret Saati (Eski: VisitedAt.ToString('HH:mm') yerine FormattedTime) -->
                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedTime}"
                                        FontSize="12" Opacity="0.5" VerticalAlignment="Center" Width="44" />

                            <!-- Sayfa Başlığı -->
                            <TextBlock Grid.Column="2" Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                            <!-- URL -->
                            <TextBlock Grid.Column="3" Text="{x:Bind Url}" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                            <!-- Tekil Sil Butonu -->
                            <Button Grid.Column="4" Width="28" Height="28" Padding="0"
                                    Background="Transparent" BorderThickness="0" CornerRadius="4"
                                    ToolTipService.ToolTip="Kaldır" Click="DeleteHistoryItem_Click" Tag="{x:Bind Id}">
                                <FontIcon Glyph="&#xE711;" FontSize="11" Opacity="0.6" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>