<UserControl
    x:Class="Bear_Browser.Controls.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootLayoutGrid">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#140C07" Offset="0.0" />
                    <GradientStop Color="#20130B" Offset="0.4" />
                    <GradientStop Color="#160D07" Offset="0.8" />
                    <GradientStop Color="#0D0704" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-60,0,0"
                Width="900" Height="450" Opacity="0.35" CornerRadius="450" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#E07A1E" Offset="0.0" />
                    <GradientStop Color="#78350F" Offset="0.5" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Border Width="680" Background="#1D1510" BorderBrush="#30E07A1E" BorderThickness="1.5"
                        CornerRadius="20" Padding="36,32">
                    <Grid RowDefinitions="Auto,*,Auto">
                        
                        <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                                <Border Width="40" Height="40" CornerRadius="20" BorderBrush="#40E07A1E" BorderThickness="1.5">
                                    <Image Source="ms-appx:///Assets/Bear-Browser-Logo.jpg" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="BEAR BROWSER" FontSize="11" FontWeight="Bold" Foreground="#E07A1E" CharacterSpacing="120" />
                                    <TextBlock Text="İlk Kurulum Sihirbazı" FontSize="13" Foreground="#A89E96" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="StepIndicatorsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <Border x:Name="StepDot1" Width="28" Height="6" CornerRadius="3" Background="#E07A1E" />
                                <Border x:Name="StepDot2" Width="8" Height="6" CornerRadius="3" Background="#30FFFFFF" />
                                <Border x:Name="StepDot3" Width="8" Height="6" CornerRadius="3" Background="#30FFFFFF" />
                                <Border x:Name="StepDot4" Width="8" Height="6" CornerRadius="3" Background="#30FFFFFF" />
                                <Border x:Name="StepDot5" Width="8" Height="6" CornerRadius="3" Background="#30FFFFFF" />
                                <Border x:Name="StepDot6" Width="8" Height="6" CornerRadius="3" Background="#30FFFFFF" />
                                <Border x:Name="StepDot7" Width="8" Height="6" CornerRadius="3" Background="#30FFFFFF" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" MinHeight="360">
                            
                            <StackPanel x:Name="Step1Panel" Visibility="Visible" Spacing="20">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Profilinizi Oluşturun 🐻" FontSize="22" FontWeight="Bold" Foreground="#F5EDE4" HorizontalAlignment="Center" />
                                    <TextBlock Text="Bear Browser'ı size özel kılmak için adınızı ve bir avatar seçin." FontSize="13" Foreground="#A89E96" HorizontalAlignment="Center" />
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Center" Spacing="12">
                                    <Grid Width="96" Height="96" HorizontalAlignment="Center">
                                        <Border x:Name="AvatarBorderContainer" CornerRadius="48" BorderBrush="#E07A1E" BorderThickness="2.5" Background="#261A12">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image x:Name="AvatarImagePreview" Width="92" Height="92" Stretch="UniformToFill" Visibility="Collapsed" />
                                                <TextBlock x:Name="AvatarEmojiPreview" Text="🐻" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <Button Tag="🐻" Click="PresetAvatar_Click" Width="40" Height="40" CornerRadius="20" Background="#261A12" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="0">
                                            <TextBlock Text="🐻" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Tag="🐼" Click="PresetAvatar_Click" Width="40" Height="40" CornerRadius="20" Background="#261A12" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="0">
                                            <TextBlock Text="🐼" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Tag="🦊" Click="PresetAvatar_Click" Width="40" Height="40" CornerRadius="20" Background="#261A12" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="0">
                                            <TextBlock Text="🦊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Tag="🦁" Click="PresetAvatar_Click" Width="40" Height="40" CornerRadius="20" Background="#261A12" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="0">
                                            <TextBlock Text="🦁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Tag="🚀" Click="PresetAvatar_Click" Width="40" Height="40" CornerRadius="20" Background="#261A12" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="0">
                                            <TextBlock Text="🚀" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Tag="💻" Click="PresetAvatar_Click" Width="40" Height="40" CornerRadius="20" Background="#261A12" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="0">
                                            <TextBlock Text="💻" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Tag="☕" Click="PresetAvatar_Click" Width="40" Height="40" CornerRadius="20" Background="#261A12" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="0">
                                            <TextBlock Text="☕" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>

                                    <Button x:Name="PickCustomAvatarBtn" Click="PickCustomAvatarBtn_Click" HorizontalAlignment="Center"
                                            Background="#261A12" BorderBrush="#35E07A1E" BorderThickness="1" CornerRadius="10" Padding="14,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="13" Foreground="#E07A1E" />
                                            <TextBlock Text="Fotoğraf Seç ve Kırp..." FontSize="12.5" Foreground="#F5EDE4" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Spacing="6" Width="360" HorizontalAlignment="Center">
                                    <TextBlock Text="Profil Adınız" FontSize="12" FontWeight="SemiBold" Foreground="#A89E96" />
                                    <TextBox x:Name="ProfileNameInput" Text="Kullanıcı 1" FontSize="14" Height="40"
                                             Background="#241912" Foreground="#F5EDE4" BorderBrush="#35E07A1E" BorderThickness="1" CornerRadius="10"
                                             TextChanged="ProfileNameInput_TextChanged" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="Step2Panel" Visibility="Collapsed" Spacing="20">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Sekmeleriniz Nerede Dursun? 📑" FontSize="22" FontWeight="Bold" Foreground="#F5EDE4" HorizontalAlignment="Center" />
                                    <TextBlock Text="Çalışma tarzınıza en uygun sekme yerleşimini seçin:" FontSize="13" Foreground="#A89E96" HorizontalAlignment="Center" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,10,0,0">
                                    <Border x:Name="TabPosTopCard" Grid.Column="0" Tapped="TabPosTopCard_Tapped"
                                            Background="#221710" BorderBrush="#E07A1E" BorderThickness="2" CornerRadius="14" Padding="20">
                                        <StackPanel Spacing="12">
                                            <Border Height="80" Background="#160E09" CornerRadius="10" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="10">
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Width="65" Height="18" Background="#E07A1E" CornerRadius="6" />
                                                        <Border Width="65" Height="18" Background="#28FFFFFF" CornerRadius="6" />
                                                        <Border Width="18" Height="18" Background="#15FFFFFF" CornerRadius="9" />
                                                    </StackPanel>
                                                    <Border Height="34" Background="#1E140D" CornerRadius="6" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="Üst Sekmeler (Yatay)" FontSize="15" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                                    <FontIcon x:Name="TabTopCheckIcon" Glyph="&#xE73E;" FontSize="14" Foreground="#E07A1E" Visibility="Visible" />
                                                </StackPanel>
                                                <TextBlock Text="Klasik ve alışıldık tarayıcı düzeni. Sekmeler ekranın en üstünde yatay olarak sıralanır." FontSize="12" Foreground="#A89E96" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="TabPosLeftCard" Grid.Column="1" Tapped="TabPosLeftCard_Tapped"
                                            Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1.5" CornerRadius="14" Padding="20">
                                        <StackPanel Spacing="12">
                                            <Border Height="80" Background="#160E09" CornerRadius="10" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="8">
                                                <Grid ColumnDefinitions="48,*">
                                                    <StackPanel Grid.Column="0" Spacing="6">
                                                        <Border Height="14" Background="#E07A1E" CornerRadius="4" />
                                                        <Border Height="14" Background="#28FFFFFF" CornerRadius="4" />
                                                        <Border Height="14" Background="#28FFFFFF" CornerRadius="4" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Margin="8,0,0,0" Background="#1E140D" CornerRadius="6" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="Sol Sekmeler (Dikey)" FontSize="15" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                                    <FontIcon x:Name="TabLeftCheckIcon" Glyph="&#xE73E;" FontSize="14" Foreground="#E07A1E" Visibility="Collapsed" />
                                                </StackPanel>
                                                <TextBlock Text="Modern Arc tarzı düzen. Sayfalarınız için daha geniş dikey görüş alanı ve düzenli çalışma alanı sağlar." FontSize="12" Foreground="#A89E96" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="Step3Panel" Visibility="Collapsed" Spacing="20">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Sık Kullanılanlar Çubuğu ⭐" FontSize="22" FontWeight="Bold" Foreground="#F5EDE4" HorizontalAlignment="Center" />
                                    <TextBlock Text="Favori sitelerinize tek tıkla ulaşmak için yer imleri çubuğu açık olsun mu?" FontSize="13" Foreground="#A89E96" HorizontalAlignment="Center" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,14,0,0">
                                    <Border x:Name="FavBarShowCard" Grid.Column="0" Tapped="FavBarShowCard_Tapped"
                                            Background="#221710" BorderBrush="#E07A1E" BorderThickness="2" CornerRadius="14" Padding="20">
                                        <StackPanel Spacing="10">
                                            <Border Width="48" Height="48" CornerRadius="24" Background="#28E07A1E" HorizontalAlignment="Left">
                                                <FontIcon Glyph="&#xE735;" FontSize="20" Foreground="#E07A1E" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Her Zaman Göster (Önerilen)" FontSize="15" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                                <FontIcon x:Name="FavShowCheckIcon" Glyph="&#xE73E;" FontSize="14" Foreground="#E07A1E" Visibility="Visible" />
                                            </StackPanel>
                                            <TextBlock Text="Sık kullanılanlar çubuğu adres çubuğunun hemen altında sürekli görünür kalsın." FontSize="12" Foreground="#A89E96" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="FavBarHideCard" Grid.Column="1" Tapped="FavBarHideCard_Tapped"
                                            Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1.5" CornerRadius="14" Padding="20">
                                        <StackPanel Spacing="10">
                                            <Border Width="48" Height="48" CornerRadius="24" Background="#15FFFFFF" HorizontalAlignment="Left">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="#A89E96" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Sade Görünüm (Gizle)" FontSize="15" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                                <FontIcon x:Name="FavHideCheckIcon" Glyph="&#xE73E;" FontSize="14" Foreground="#E07A1E" Visibility="Collapsed" />
                                            </StackPanel>
                                            <TextBlock Text="Daha fazla sayfa içeriği görmek için çubuğu gizle. Dilediğinizde ayarlardan açabilirsiniz." FontSize="12" Foreground="#A89E96" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="Step4Panel" Visibility="Collapsed" Spacing="20">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Varsayılan Arama Motoru 🔍" FontSize="22" FontWeight="Bold" Foreground="#F5EDE4" HorizontalAlignment="Center" />
                                    <TextBlock Text="Adres çubuğuna bir arama yazdığınızda hangi motor kullanılsın?" FontSize="13" Foreground="#A89E96" HorizontalAlignment="Center" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" RowSpacing="12" ColumnSpacing="12" Margin="0,10,0,0">
                                    <Border x:Name="SearchGoogleCard" Grid.Row="0" Grid.Column="0" Tapped="SearchCard_Tapped" Tag="Google"
                                            Background="#221710" BorderBrush="#E07A1E" BorderThickness="2" CornerRadius="12" Padding="16">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Google" FontSize="15" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                                <TextBlock Text="Dünyanın en popüler ve kapsamlı arama motoru." FontSize="11.5" Foreground="#A89E96" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <FontIcon x:Name="SearchGoogleCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="14" Foreground="#E07A1E" Visibility="Visible" />
                                        </Grid>
                                    </Border>

                                    <Border x:Name="SearchDuckCard" Grid.Row="0" Grid.Column="1" Tapped="SearchCard_Tapped" Tag="DuckDuckGo"
                                            Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1.5" CornerRadius="12" Padding="16">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="DuckDuckGo" FontSize="15" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                                <TextBlock Text="Kişisel verilerinizi kaydetmeyen gizlilik odaklı arama." FontSize="11.5" Foreground="#A89E96" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <FontIcon x:Name="SearchDuckCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="14" Foreground="#E07A1E" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>

                                    <Border x:Name="SearchBingCard" Grid.Row="1" Grid.Column="0" Tapped="SearchCard_Tapped" Tag="Bing"
                                            Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1.5" CornerRadius="12" Padding="16">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Microsoft Bing" FontSize="15" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                                <TextBlock Text="Microsoft yapay zeka destekli akıllı arama." FontSize="11.5" Foreground="#A89E96" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <FontIcon x:Name="SearchBingCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="14" Foreground="#E07A1E" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>

                                    <Border x:Name="SearchYandexCard" Grid.Row="1" Grid.Column="1" Tapped="SearchCard_Tapped" Tag="Yandex"
                                            Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1.5" CornerRadius="12" Padding="16">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Yandex" FontSize="15" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                                <TextBlock Text="Hızlı, görsel ve bölgesel zengin arama." FontSize="11.5" Foreground="#A89E96" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <FontIcon x:Name="SearchYandexCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="14" Foreground="#E07A1E" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="Step5Panel" Visibility="Collapsed" Spacing="20">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Dil ve Görünüm 🎨" FontSize="22" FontWeight="Bold" Foreground="#F5EDE4" HorizontalAlignment="Center" />
                                    <TextBlock Text="Gözlerinize ve dilinize en uygun deneyimi belirleyin:" FontSize="13" Foreground="#A89E96" HorizontalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Arayüz Dili" FontSize="13" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                                        <Border x:Name="LangTrCard" Grid.Column="0" Tapped="LangCard_Tapped" Tag="tr"
                                                Background="#221710" BorderBrush="#E07A1E" BorderThickness="2" CornerRadius="10" Padding="8,14">
                                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="TR" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock Text="Türkçe" FontSize="11" Foreground="#A89E96" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="LangEnCard" Grid.Column="1" Tapped="LangCard_Tapped" Tag="en"
                                                Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="8,14">
                                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="EN" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock Text="English" FontSize="11" Foreground="#A89E96" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="LangDeCard" Grid.Column="2" Tapped="LangCard_Tapped" Tag="de"
                                                Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="8,14">
                                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="DE" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock Text="Deutsch" FontSize="11" Foreground="#A89E96" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="LangEsCard" Grid.Column="3" Tapped="LangCard_Tapped" Tag="es"
                                                Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="8,14">
                                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="ES" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock Text="Español" FontSize="11" Foreground="#A89E96" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="LangFrCard" Grid.Column="4" Tapped="LangCard_Tapped" Tag="fr"
                                                Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="8,14">
                                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="FR" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock Text="Français" FontSize="11" Foreground="#A89E96" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="8" Margin="0,6,0,0">
                                    <TextBlock Text="Arayüz Teması" FontSize="13" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                        <Border x:Name="ThemeDarkCard" Grid.Column="0" Tapped="ThemeCard_Tapped" Tag="Dark"
                                                Background="#221710" BorderBrush="#E07A1E" BorderThickness="2" CornerRadius="12" Padding="14">
                                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE708;" FontSize="20" Foreground="#E07A1E" HorizontalAlignment="Center" />
                                                <TextBlock Text="Koyu (Önerilen)" FontSize="13" FontWeight="SemiBold" Foreground="#F5EDE4" HorizontalAlignment="Center" />
                                                <TextBlock Text="Sıcak kahve tonları" FontSize="11" Foreground="#A89E96" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="ThemeLightCard" Grid.Column="1" Tapped="ThemeCard_Tapped" Tag="Light"
                                                Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14">
                                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE706;" FontSize="20" Foreground="#A89E96" HorizontalAlignment="Center" />
                                                <TextBlock Text="Açık" FontSize="13" FontWeight="SemiBold" Foreground="#F5EDE4" HorizontalAlignment="Center" />
                                                <TextBlock Text="Ferah ve aydınlık" FontSize="11" Foreground="#A89E96" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="Step6Panel" Visibility="Collapsed" Spacing="16">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Güvenlik ve Reklam Kalkanı 🛡️" FontSize="22" FontWeight="Bold" Foreground="#F5EDE4" HorizontalAlignment="Center" />
                                    <TextBlock Text="Daha hızlı sayfalar ve kesintisiz video deneyimi için korumalar:" FontSize="13" Foreground="#A89E96" HorizontalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Spacing="10" Margin="0,8,0,0">
                                    <Border Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#25E07A1E" Margin="0,0,12,0">
                                                <FontIcon Glyph="&#xE730;" FontSize="16" Foreground="#E07A1E" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Bear AdBlock" FontSize="13.5" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                                <TextBlock Text="Sayfalardaki ve videolardaki can sıkıcı reklamları otomatik engeller." FontSize="11.5" Foreground="#A89E96" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="AdBlockToggle" Grid.Column="2" IsOn="True" Toggled="AdBlockToggle_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#15FFFFFF" Margin="0,0,12,0">
                                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#A89E96" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Do Not Track (Beni İzleme)" FontSize="13.5" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                                <TextBlock Text="Web sitelerine kişisel verilerinizin takip edilmemesi sinyalini iletir." FontSize="11.5" Foreground="#A89E96" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="DoNotTrackToggle" Grid.Column="2" IsOn="True" Toggled="DoNotTrackToggle_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Background="#221710" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#15FFFFFF" Margin="0,0,12,0">
                                                <FontIcon Glyph="&#xE8D7;" FontSize="16" Foreground="#A89E96" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Yerel Parola Yöneticisi" FontSize="13.5" FontWeight="SemiBold" Foreground="#F5EDE4" />
                                                <TextBlock Text="Web sitelerinde parolalarınızı cihazınızda şifreli olarak kaydetmeyi önerir." FontSize="11.5" Foreground="#A89E96" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="AskPasswordToggle" Grid.Column="2" IsOn="True" Toggled="AskPasswordToggle_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="Step7Panel" Visibility="Collapsed" Spacing="20">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Her Şey Hazır! 🎉" FontSize="24" FontWeight="Bold" Foreground="#F5EDE4" HorizontalAlignment="Center" />
                                    <TextBlock Text="Bear Browser tamamen sizin tercihlerinize göre yapılandırıldı." FontSize="13.5" Foreground="#A89E96" HorizontalAlignment="Center" />
                                </StackPanel>

                                <Border Width="480" HorizontalAlignment="Center" Background="#241811" BorderBrush="#40E07A1E" BorderThickness="1.5" CornerRadius="14" Padding="20">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="SEÇİLEN YAPILANDIRMA" FontSize="11" FontWeight="Bold" Foreground="#E07A1E" CharacterSpacing="100" />
                                        
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                            <TextBlock Grid.Row="0" Text="👤 Profil:" FontSize="13" Foreground="#A89E96" />
                                            <TextBlock x:Name="SummaryProfileText" Grid.Row="0" Text="Kullanıcı 1" FontSize="13" FontWeight="SemiBold" Foreground="#F5EDE4" HorizontalAlignment="Right" />

                                            <TextBlock Grid.Row="1" Text="📑 Sekme Düzeni:" FontSize="13" Foreground="#A89E96" />
                                            <TextBlock x:Name="SummaryTabPosText" Grid.Row="1" Text="Üst Sekmeler (Yatay)" FontSize="13" FontWeight="SemiBold" Foreground="#F5EDE4" HorizontalAlignment="Right" />

                                            <TextBlock Grid.Row="2" Text="⭐ Sık Kullanılanlar:" FontSize="13" Foreground="#A89E96" />
                                            <TextBlock x:Name="SummaryFavBarText" Grid.Row="2" Text="Her Zaman Göster" FontSize="13" FontWeight="SemiBold" Foreground="#F5EDE4" HorizontalAlignment="Right" />

                                            <TextBlock Grid.Row="3" Text="🔍 Arama Motoru:" FontSize="13" Foreground="#A89E96" />
                                            <TextBlock x:Name="SummarySearchText" Grid.Row="3" Text="Google" FontSize="13" FontWeight="SemiBold" Foreground="#F5EDE4" HorizontalAlignment="Right" />

                                            <TextBlock Grid.Row="4" Text="🛡️ Reklam Kalkanı:" FontSize="13" Foreground="#A89E96" />
                                            <TextBlock x:Name="SummaryAdBlockText" Grid.Row="4" Text="Aktif" FontSize="13" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="StartBrowsingBtn" Click="StartBrowsingBtn_Click" HorizontalAlignment="Center"
                                        Width="260" Height="46" Background="#E07A1E" Foreground="White" FontWeight="Bold" FontSize="14"
                                        CornerRadius="12" BorderThickness="0" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White" />
                                        <TextBlock Text="Gezinmeye Başla" FontSize="14" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                        </Grid>

                        <Grid Grid.Row="2" Margin="0,24,0,0">
                            <Button x:Name="PrevStepBtn" Click="PrevStepBtn_Click" Visibility="Collapsed" HorizontalAlignment="Left"
                                    Background="Transparent" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72B;" FontSize="12" Foreground="#A89E96" />
                                    <TextBlock Text="Geri" FontSize="13" Foreground="#F5EDE4" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="StepCountText" Text="Adım 1 / 7" FontSize="12" FontWeight="SemiBold" Foreground="#A89E96"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                <Button x:Name="SkipBtn" Click="SkipBtn_Click" Background="Transparent" BorderThickness="0" Padding="12,8">
                                    <TextBlock Text="Varsayılanlarla Başla" FontSize="12.5" Foreground="#A89E96" />
                                </Button>

                                <Button x:Name="NextStepBtn" Click="NextStepBtn_Click"
                                        Background="#E07A1E" Foreground="White" FontWeight="Bold" FontSize="13" CornerRadius="10" Padding="20,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="NextStepBtnText" Text="İleri" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                        <FontIcon x:Name="NextStepBtnIcon" Glyph="&#xE72A;" FontSize="12" Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
