<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bear_Browser.Controls.DownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Bear_Browser.Models">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="450" Height="250" Canvas.Left="-100" Canvas.Top="-50" Opacity="0.06">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                        
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <ScrollViewer Padding="36,24,36,36">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">
                <Grid ColumnSpacing="16" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12"
                                Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1">
                            <FontIcon Glyph="&#xE896;" FontSize="17" Foreground="{ThemeResource ArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="İndirmeler" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                <Border Background="{ThemeResource ArcSurfaceDefaultBrush}" BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CountBadgeText" Text="0 dosya" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" HorizontalAlignment="Center" Width="320" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource ArcCompactSearchBoxStyle}"
                                 PlaceholderText="İndirilenlerde ara..."
                                 TextChanged="SearchBox_TextChanged" />
                        <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource ArcTextSecondaryBrush}"
                                  HorizontalAlignment="Left" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="OpenFolderBtn" Style="{StaticResource ArcPillButtonStyle}" Click="OpenFolderBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xED25;" FontSize="12" Foreground="{ThemeResource ArcAccentBrush}" />
                                
                                <TextBlock Text="Klasörü Aç" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearAllBtn" Style="{StaticResource ArcPillButtonStyle}" Click="ClearAllDownloads_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#EF4444" />
                                
                                <TextBlock Text="Temizle" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="EmptyStateContainer" Style="{StaticResource ArcCardStyle}" Padding="40" HorizontalAlignment="Stretch" Visibility="Collapsed">
                    <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="440">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{ThemeResource ArcSurfaceDefaultBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="28" Foreground="{ThemeResource ArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        
                        <TextBlock Text="Henüz indirilen bir dosya yok" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                        
                        <TextBlock Text="Web sitelerinden dosya indirdiğinizde ilerleme durumu ve indirilen dosyalar burada görünecektir."
                                   FontSize="13" Foreground="{ThemeResource ArcTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ListView x:Name="DownloadsListView" SelectionMode="None" Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                        </Style>
                        
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DownloadItem">
                            <Border Style="{StaticResource ArcCardStyle}" Padding="14,10" HorizontalAlignment="Stretch">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                            Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                            BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <FontIcon Glyph="{x:Bind FileTypeGlyph}" FontSize="16" Foreground="{ThemeResource ArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border Background="{ThemeResource ArcSurfaceSubtleBrush}" CornerRadius="3" Padding="2,0.5"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2">
                                                <TextBlock Text="{x:Bind FileExtensionText}" FontSize="8" FontWeight="Bold" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{x:Bind FileName}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ArcTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Background="{ThemeResource ArcSurfaceSubtleBrush}" CornerRadius="4" Padding="6,1.5">
                                                <TextBlock Text="{x:Bind StatusText}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource ArcAccentBrush}" />
                                            </Border>
                                            <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind FormattedTime}" FontSize="11" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                        </StackPanel>

                                        <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}" Maximum="100"
                                                     Visibility="{x:Bind IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     Height="3" CornerRadius="1.5" Margin="0,3,0,0" Foreground="{ThemeResource ArcAccentBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ArcPillButtonStyle}" Padding="10,4"
                                                Click="OpenFile_Click" Tag="{x:Bind FilePath}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8E5;" FontSize="11" />
                                                <TextBlock Text="Dosyayı Aç" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>

                                        <Button Width="30" Height="30" Padding="0"
                                                Style="{StaticResource ArcIconButtonStyle}"
                                                ToolTipService.ToolTip="Klasörde göster"
                                                Click="ShowInFolder_Click" Tag="{x:Bind FilePath}">
                                            <FontIcon Glyph="&#xED25;" FontSize="12" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                        </Button>

                                        <Button Width="30" Height="30" Padding="0"
                                                Style="{StaticResource ArcIconButtonStyle}"
                                                ToolTipService.ToolTip="Listeden kaldır"
                                                Click="DeleteItem_Click" Tag="{x:Bind Id}">
                                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>