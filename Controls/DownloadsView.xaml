<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bear_Browser.Controls.DownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Bear_Browser.Models">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SOL BÖLME -->
        <Grid Grid.Column="0" Padding="16,20,12,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE896;" FontSize="18" />
                <TextBlock Text="İndirilenler" FontWeight="SemiBold" FontSize="18" />
            </StackPanel>

            <TextBox x:Name="SearchBox" Grid.Row="1" Height="34"
                     PlaceholderText="İndirilenlerde ara..."
                     TextChanged="SearchBox_TextChanged" />

            <Button Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Padding="10,8" Click="OpenFolderBtn_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xED25;" FontSize="13" />
                    <TextBlock Text="İndirilenler klasörünü aç" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- SAĞ BÖLME -->
        <Grid Grid.Column="2" Padding="28,20,28,16" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="Tüm İndirilenler" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Padding="12,6" CornerRadius="6" Click="ClearAllDownloads_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        <TextBlock Text="Listeyi temizle" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <ListView x:Name="DownloadsListView" Grid.Row="1" SelectionMode="None" Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadItem">
                        <Grid Padding="12,10" Margin="0,2" CornerRadius="6"
                              Background="{ThemeResource SubtleFillColorTransparentBrush}" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind FileName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind FormattedSize}" FontSize="11" Opacity="0.5" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedTime}" FontSize="12" Opacity="0.5" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Padding="8,4" CornerRadius="4" Click="OpenFile_Click" Tag="{x:Bind FilePath}">
                                    <TextBlock Text="Dosyayı aç" FontSize="12" />
                                </Button>
                                <Button Width="30" Height="30" Padding="0" Click="ShowInFolder_Click" Tag="{x:Bind FilePath}"
                                        ToolTipService.ToolTip="Klasörde göster">
                                    <FontIcon Glyph="&#xED25;" FontSize="12" />
                                </Button>
                                <Button Width="30" Height="30" Padding="0" Click="DeleteItem_Click" Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="Kaldır">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" Opacity="0.6" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>