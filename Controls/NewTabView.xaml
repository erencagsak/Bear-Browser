<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bear_Browser.Controls.NewTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ArcCanvasBackgroundBrush}">
        <!-- Arka Plan Hafif Radyal Işık Efekti -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                Width="600" Height="300" Opacity="0.08"
                Background="{ThemeResource ArcAccentBrush}"
                CornerRadius="300" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="720" Margin="24,60,24,60" Spacing="28">

                <!-- 1. AYI LOGOSU & KARŞILAMA -->
                <StackPanel HorizontalAlignment="Center" Spacing="16">
                    <Border Width="84" Height="84" CornerRadius="42"
                            BorderBrush="{ThemeResource ArcBorderDefaultBrush}"
                            BorderThickness="1.5"
                            HorizontalAlignment="Center">
                        <Border.Background>
                            <ImageBrush ImageSource="ms-appx:///Assets/Bear-Browser-Logo.jpg" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Bear Browser"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{ThemeResource ArcTextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="TaglineText" Text="Hızlı, Güvenli ve Özgür Web Deneyimi"
                                   FontSize="13.5" Foreground="{ThemeResource ArcTextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- 2. MERKEZİ ARAMA KUTUSU -->
                <Grid Width="600" HorizontalAlignment="Center">
                    <Border Background="{ThemeResource ArcAddressBarBackgroundBrush}"
                            BorderBrush="{ThemeResource ArcAddressBarBorderBrush}"
                            BorderThickness="1.5" CornerRadius="24"
                            Padding="6,3">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="15"
                                      Foreground="{ThemeResource ArcTextSecondaryBrush}" Margin="14,0,8,0" VerticalAlignment="Center" />

                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     PlaceholderText="Web'de arayın veya bir URL yazın..."
                                     FontSize="14.5" Height="42"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{ThemeResource ArcTextPrimaryBrush}"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchBox_KeyDown" />

                            <Button x:Name="SearchSubmitBtn" Grid.Column="2"
                                    Width="36" Height="36" CornerRadius="18"
                                    Style="{StaticResource ArcAccentButtonStyle}"
                                    Padding="0" Margin="0,0,2,0"
                                    ToolTipService.ToolTip="Ara"
                                    Click="SearchSubmitBtn_Click">
                                <FontIcon Glyph="&#xE751;" FontSize="12" Foreground="White" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. HIZLI ERİŞİM KISAYOLLARI (SHORTCUT TILES) -->
                <StackPanel Spacing="14" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock x:Name="QuickAccessTitleText" Text="Hızlı Erişim" FontSize="13" FontWeight="SemiBold"
                               Opacity="0.6" HorizontalAlignment="Center" />

                    <!-- Kısayol Kartları Izgarası -->
                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"
                                           HorizontalAlignment="Center">

                        <!-- YouTube -->
                        <Button Tag="https://www.youtube.com" Click="Shortcut_Click"
                                PointerPressed="Shortcut_PointerPressed"
                                Width="140" Height="96" Margin="6" CornerRadius="12"
                                Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                BorderBrush="{ThemeResource ArcBorderSubtleBrush}"
                                BorderThickness="1" Padding="12">
                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#FF0000">
                                    <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="YouTube" FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Google -->
                        <Button Tag="https://www.google.com" Click="Shortcut_Click"
                                PointerPressed="Shortcut_PointerPressed"
                                Width="140" Height="96" Margin="6" CornerRadius="12"
                                Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                BorderBrush="{ThemeResource ArcBorderSubtleBrush}"
                                BorderThickness="1" Padding="12">
                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#4285F4">
                                    <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Google" FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- GitHub -->
                        <Button Tag="https://www.github.com" Click="Shortcut_Click"
                                PointerPressed="Shortcut_PointerPressed"
                                Width="140" Height="96" Margin="6" CornerRadius="12"
                                Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                BorderBrush="{ThemeResource ArcBorderSubtleBrush}"
                                BorderThickness="1" Padding="12">
                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#24292e">
                                    <FontIcon Glyph="&#xE943;" FontSize="18" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="GitHub" FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- X / Twitter -->
                        <Button Tag="https://x.com" Click="Shortcut_Click"
                                PointerPressed="Shortcut_PointerPressed"
                                Width="140" Height="96" Margin="6" CornerRadius="12"
                                Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                BorderBrush="{ThemeResource ArcBorderSubtleBrush}"
                                BorderThickness="1" Padding="12">
                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#000000">
                                    <FontIcon Glyph="&#xE715;" FontSize="18" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="X (Twitter)" FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Wikipedia -->
                        <Button Tag="https://www.wikipedia.org" Click="Shortcut_Click"
                                PointerPressed="Shortcut_PointerPressed"
                                Width="140" Height="96" Margin="6" CornerRadius="12"
                                Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                BorderBrush="{ThemeResource ArcBorderSubtleBrush}"
                                BorderThickness="1" Padding="12">
                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#636466">
                                    <FontIcon Glyph="&#xE82D;" FontSize="18" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Vikipedi" FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Reddit -->
                        <Button Tag="https://www.reddit.com" Click="Shortcut_Click"
                                PointerPressed="Shortcut_PointerPressed"
                                Width="140" Height="96" Margin="6" CornerRadius="12"
                                Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                BorderBrush="{ThemeResource ArcBorderSubtleBrush}"
                                BorderThickness="1" Padding="12">
                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#FF4500">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="18" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Reddit" FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Chrome Web Mağazası -->
                        <Button Tag="https://chromewebstore.google.com" Click="Shortcut_Click"
                                PointerPressed="Shortcut_PointerPressed"
                                Width="140" Height="96" Margin="6" CornerRadius="12"
                                Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                BorderBrush="{ThemeResource ArcBorderSubtleBrush}"
                                BorderThickness="1" Padding="12">
                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE74C;" FontSize="18" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Uzantılar" FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Ayarlar -->
                        <Button Tag="bear://settings" Click="Shortcut_Click"
                                PointerPressed="Shortcut_PointerPressed"
                                Width="140" Height="96" Margin="6" CornerRadius="12"
                                Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                BorderBrush="{ThemeResource ArcBorderSubtleBrush}"
                                BorderThickness="1" Padding="12">
                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#71717A">
                                    <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Ayarlar" FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </VariableSizedWrapGrid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
