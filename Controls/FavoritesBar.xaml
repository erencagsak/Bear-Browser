<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bear_Browser.Controls.FavoritesBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Bear_Browser.Models">

    <Border Height="34" Padding="12,0" Background="{ThemeResource SubtleFillColorTransparentBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <StackPanel x:Name="BarItemsPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
        </ScrollViewer>
    </Border>
</UserControl>