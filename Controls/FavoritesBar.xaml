<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bear_Browser.Controls.FavoritesBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Bear_Browser.Models">

    <Grid x:Name="BarRootGrid" Height="34" Padding="8,0" Background="{ThemeResource SubtleFillColorTransparentBrush}"
          AllowDrop="True" DragOver="BarRootGrid_DragOver" DragLeave="BarRootGrid_DragLeave" Drop="BarRootGrid_Drop" SizeChanged="BarRootGrid_SizeChanged">
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Yeni klasör ekle" Click="AddFolderMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xED25;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Sık kullanılanlar çubuğunu gizle" Click="HideBarMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xED1A;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="BarItemsPanel" Grid.Column="0" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" HorizontalAlignment="Left"
                        AllowDrop="True" DragOver="BarRootGrid_DragOver" DragLeave="BarRootGrid_DragLeave" Drop="BarRootGrid_Drop" />

            <Canvas Grid.Column="0" IsHitTestVisible="False">
                <Border x:Name="DropIndicatorLine" Width="3" Height="22" CornerRadius="1.5"
                        Background="#FF7A18" Visibility="Collapsed" Canvas.Top="3" />
            </Canvas>

            <Button x:Name="OverflowButton" Grid.Column="1"
                    Width="28" Height="28" Padding="0"
                    CornerRadius="14" Margin="2,0,0,0"
                    Background="Transparent" BorderThickness="0"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Diğer sık kullanılanlar">
                <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                <Button.Flyout>
                    <MenuFlyout x:Name="OverflowFlyout" Placement="BottomEdgeAlignedRight">
                        <MenuFlyout.MenuFlyoutPresenterStyle>
                            <Style TargetType="MenuFlyoutPresenter">
                                <Setter Property="MinWidth" Value="150" />
                                <Setter Property="MaxWidth" Value="210" />
                                <Setter Property="MaxHeight" Value="360" />
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Padding" Value="4" />
                            </Style>
                        </MenuFlyout.MenuFlyoutPresenterStyle>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Button x:Name="HiddenFolderDialogTarget" Opacity="0" Width="1" Height="1" IsHitTestVisible="False">
            <Button.Flyout>
                <Flyout x:Name="NewFolderFlyout">
                    <StackPanel Width="240" Spacing="10" Padding="8">
                        <TextBlock Text="Yeni Klasör Ekle" FontWeight="SemiBold" FontSize="14" />
                        <TextBox x:Name="NewFolderTextBox" PlaceholderText="Klasör adı..." KeyDown="NewFolderTextBox_KeyDown" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="İptal" Click="CancelNewFolder_Click" />
                            <Button Content="Ekle" Style="{StaticResource AccentButtonStyle}" Click="ConfirmNewFolder_Click" />
                        </StackPanel>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <Button x:Name="HiddenEditDialogTarget" Opacity="0" Width="1" Height="1" IsHitTestVisible="False">
            <Button.Flyout>
                <Flyout x:Name="EditBookmarkFlyout">
                    <StackPanel Width="260" Spacing="10" Padding="8">
                        <TextBlock Text="Sık Kullanılanı Düzenle" FontWeight="SemiBold" FontSize="14" />
                        <TextBox x:Name="EditNameTextBox" Header="Ad" />
                        <TextBox x:Name="EditUrlTextBox" Header="URL" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="İptal" Click="CancelEdit_Click" />
                            <Button Content="Kaydet" Style="{StaticResource AccentButtonStyle}" Click="ConfirmEdit_Click" />
                        </StackPanel>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>