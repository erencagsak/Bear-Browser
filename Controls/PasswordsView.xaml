<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bear_Browser.Controls.PasswordsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Bear_Browser.Models">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="450" Height="250" Canvas.Left="-100" Canvas.Top="-50" Opacity="0.06">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <ScrollViewer Padding="36,24,36,36">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">
                <Grid ColumnSpacing="16" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12"
                                Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1">
                            <FontIcon Glyph="&#xE8D7;" FontSize="17" Foreground="{ThemeResource ArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Parolalar" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                                <Border Background="{ThemeResource ArcSurfaceDefaultBrush}" BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CountBadgeText" Text="0 hesap" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" HorizontalAlignment="Center" Width="320" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource ArcCompactSearchBoxStyle}"
                                 PlaceholderText="Parolalarda ara..."
                                 TextChanged="SearchBox_TextChanged" />
                        <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource ArcTextSecondaryBrush}"
                                  HorizontalAlignment="Left" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="ImportPasswordsBtn" Style="{StaticResource ArcPillButtonStyle}" Click="ImportPasswordsBtn_Click" ToolTipService.ToolTip="CSV dosyasından içe aktar">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B5;" FontSize="12" Foreground="{ThemeResource ArcAccentBrush}" />
                                <TextBlock Text="İçeri Aktar" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportPasswordsBtn" Style="{StaticResource ArcPillButtonStyle}" Click="ExportPasswordsBtn_Click" ToolTipService.ToolTip="CSV olarak dışa aktar">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEDE1;" FontSize="12" />
                                <TextBlock Text="Dışarı Aktar" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ArcPillButtonStyle}" Click="ClearAllPasswords_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#EF4444" />
                                <TextBlock Text="Temizle" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource ArcCardStyle}" Padding="14,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{ThemeResource ArcSurfaceDefaultBrush}">
                            <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Cihaz Üzerinde Yerel Güvenlik" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                            <TextBlock Text="Parolalarınız yalnızca bu bilgisayarda yerel olarak saklanır. Dilediğiniz zaman CSV formatında yedekleyebilirsiniz."
                                       FontSize="11.5" Foreground="{ThemeResource ArcTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="EmptyStateContainer" Style="{StaticResource ArcCardStyle}" Padding="40" HorizontalAlignment="Stretch" Visibility="Collapsed">
                    <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="440">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{ThemeResource ArcSurfaceDefaultBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8D7;" FontSize="28" Foreground="{ThemeResource ArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Kayıtlı parola bulunamadı" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource ArcTextPrimaryBrush}" />
                        <TextBlock Text="Web sitelerine giriş yaptığınızda tarayıcının sunduğu 'Parolayı Kaydet' seçeneğiyle şifrelerinizi buraya ekleyebilirsiniz."
                                   FontSize="13" Foreground="{ThemeResource ArcTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ListView x:Name="PasswordsListView" SelectionMode="None" Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PasswordItem">
                            <Border Style="{StaticResource ArcCardStyle}" Padding="14,10" HorizontalAlignment="Stretch">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                            Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                            BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Image Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind FaviconUri}" />
                                            </Image.Source>
                                        </Image>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{x:Bind Domain}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ArcTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Background="{ThemeResource ArcSurfaceSubtleBrush}" CornerRadius="4" Padding="6,1.5">
                                                <TextBlock Text="{x:Bind UserName}" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource ArcAccentBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind FormattedDate}" FontSize="11" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="{ThemeResource ArcSurfaceDefaultBrush}"
                                            BorderBrush="{ThemeResource ArcBorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" FontSize="13"
                                                       FontFamily="Consolas, Segoe UI" Width="100"
                                                       Foreground="{ThemeResource ArcTextPrimaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            
                                            <Button Width="28" Height="28" Padding="0"
                                                    Style="{StaticResource ArcIconButtonStyle}"
                                                    Click="TogglePasswordVisibility_Click"
                                                    Tag="{x:Bind}" ToolTipService.ToolTip="Parolayı göster / gizle">
                                                <FontIcon Glyph="{x:Bind IsPasswordVisible, Mode=OneWay, Converter={StaticResource PasswordGlyphConverter}}" FontSize="12" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                            </Button>

                                            <Button Width="28" Height="28" Padding="0"
                                                    Style="{StaticResource ArcIconButtonStyle}"
                                                    Click="CopyPassword_Click" Tag="{x:Bind Password}"
                                                    ToolTipService.ToolTip="Parolayı kopyala">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Button Grid.Column="3" Width="30" Height="30" Padding="0"
                                            Style="{StaticResource ArcIconButtonStyle}"
                                            Click="DeletePassword_Click" Tag="{x:Bind Id}"
                                            ToolTipService.ToolTip="Kayıtlı parolayı sil">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource ArcTextSecondaryBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
