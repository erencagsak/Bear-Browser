<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bear_Browser.Controls.NavigationBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bear_Browser.Controls"
    xmlns:models="using:Bear_Browser.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <!-- 0: Geri -->
            <ColumnDefinition Width="Auto" />
            <!-- 1: İleri -->
            <ColumnDefinition Width="Auto" />
            <!-- 2: Yenile -->
            <ColumnDefinition Width="*" />
            <!-- 3: Adres -->
            <ColumnDefinition Width="Auto" />
            <!-- 4: Git -->
            <ColumnDefinition Width="Auto" />
            <!-- 5: Yıldız -->
            <ColumnDefinition Width="Auto" />
            <!-- 6: İndirilenler (Yeni!) -->
            <ColumnDefinition Width="Auto" />
            <!-- 7: Uzantılar -->
            <ColumnDefinition Width="Auto" />
            <!-- 8: Profil -->
            <ColumnDefinition Width="Auto" />
            <!-- 8: Üç Nokta -->
        </Grid.ColumnDefinitions>

        <!-- 1. Geri Butonu -->
        <Button x:Name="BackButton" Grid.Column="0" Width="36" Height="36" Padding="0" 
                ToolTipService.ToolTip="Geri" Click="BackButton_Click">
            <FontIcon Glyph="&#xE72B;" FontSize="14" />
        </Button>

        <!-- 2. İleri Butonu -->
        <Button x:Name="ForwardButton" Grid.Column="1" Width="36" Height="36" Padding="0" 
                ToolTipService.ToolTip="İleri" Click="ForwardButton_Click">
            <FontIcon Glyph="&#xE72A;" FontSize="14" />
        </Button>

        <!-- 3. Yenile Butonu -->
        <Button x:Name="RefreshButton" Grid.Column="2" Width="36" Height="36" Padding="0" 
                ToolTipService.ToolTip="Yenile" Click="RefreshButton_Click">
            <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="14" />
        </Button>

        <!-- 4. Adres Çubuğu -->
        <Grid Grid.Column="3">
            <TextBox x:Name="AddressBar" Height="36" 
                 VerticalContentAlignment="Center"
                 PlaceholderText="Bir adres girin veya arama yapın..."
                 KeyDown="AddressBar_KeyDown" />
            <ProgressBar x:Name="AddressLoadingBar"
                         Height="2.5"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         CornerRadius="0,0,4,4"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Bottom"
                         Margin="3,0,3,2" />
        </Grid>

        <!-- 5. Git Butonu -->
        <Button x:Name="GoButton" Grid.Column="4" Width="36" Height="36" Padding="0" 
                ToolTipService.ToolTip="Git" Click="GoButton_Click">
            <FontIcon Glyph="&#xE751;" FontSize="14" />
        </Button>

        <!-- 6. Sık Kullanılan Eklendi / Düzenle Butonu (1. ve 2. Resimdeki Birebir Menü) -->
        <Button x:Name="BookmarkButton" Grid.Column="5" Width="36" Height="36" Padding="0" 
                ToolTipService.ToolTip="Bu sayfayı sık kullanılanlara ekle" Click="BookmarkButton_Click">
            <FontIcon x:Name="BookmarkIcon" Glyph="&#xE734;" FontSize="14" />
            <Button.Flyout>
                <Flyout x:Name="BookmarkEditFlyout" Placement="BottomEdgeAlignedRight" Opening="BookmarkEditFlyout_Opening">
                    <Grid Width="290" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Başlık ve Kapat Butonu -->
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="BookmarkTitleText" Text="Sık kullanılan eklendi" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                            <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right"
                                    Background="Transparent" BorderThickness="0" CornerRadius="4"
                                    Click="CloseBookmarkFlyout_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>

                        <!-- Adı -->
                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock x:Name="BookmarkNameLabel" Text="Adı" FontSize="13" Opacity="0.8" />
                            <TextBox x:Name="BookmarkNameTextBox" Height="34" />
                        </StackPanel>

                        <!-- Klasör -->
                        <StackPanel Grid.Row="2" Spacing="6">
                            <TextBlock x:Name="BookmarkFolderLabel" Text="Klasör" FontSize="13" Opacity="0.8" />
                            <ComboBox x:Name="BookmarkFolderComboBox" HorizontalAlignment="Stretch" Height="36">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xED25;" FontSize="13" />
                                            <TextBlock Text="{x:Bind}" FontSize="13" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Alt Butonlar: [ Bitti ]  [ Kaldır ] -->
                        <Grid Grid.Row="3" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="DoneBookmarkBtn" Content="Bitti" Style="{ThemeResource AccentButtonStyle}"
                                        MinWidth="72" CornerRadius="6" Click="DoneBookmarkBtn_Click" />
                                <Button x:Name="RemoveBookmarkBtn" Content="Kaldır"
                                        MinWidth="72" CornerRadius="6" Click="RemoveBookmarkBtn_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>

        <Button x:Name="DownloadButton" Grid.Column="6" Width="36" Height="36" Padding="0"
                ToolTipService.ToolTip="İndirilenler" Click="DownloadButton_Click">
            <Grid Width="36" Height="36">
                <!-- Ana İndirme İkonu -->
                <FontIcon Glyph="&#xE896;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- İndirilirken Mavi Dönen Halka -->
                <ProgressRing x:Name="DownloadProgressRing" Width="30" Height="30"
                              IsActive="False" Visibility="Collapsed"
                              Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- İndirme Bitince Sağ Altta Yeşil Onay Rozeti -->
                <Border x:Name="DownloadCompletedBadge" Width="13" Height="13" CornerRadius="6.5"
                        Background="#107C41" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,3,3" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE73E;" FontSize="8" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <!-- İndirilenler Açılır Popup'ı (Edge Stili) -->
            <Button.Flyout>
                <Flyout x:Name="DownloadsFlyout" Placement="BottomEdgeAlignedRight" Opening="DownloadsFlyout_Opening">
                    <Grid Width="340" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Başlık ve Klasörü Aç / Kapat Butonları -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="İndirmeler" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <Button Width="28" Height="28" Padding="0" CornerRadius="4"
                                        Background="Transparent" BorderThickness="0"
                                        Click="OpenDownloadsFolder_Click"
                                        ToolTipService.ToolTip="İndirilenler klasörünü aç">
                                    <FontIcon Glyph="&#xED25;" FontSize="12" />
                                </Button>
                                <Button Width="28" Height="28" Padding="0" CornerRadius="4"
                                        Background="Transparent" BorderThickness="0"
                                        Click="CloseDownloadsFlyout_Click"
                                        ToolTipService.ToolTip="Kapat">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- Son İndirmeler Listesi -->
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="EmptyDownloadsText" Text="Henüz indirilen dosya yok"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,20,0,20" Opacity="0.5" FontSize="13" Visibility="Collapsed" />
                            <ListView x:Name="RecentDownloadsList" MaxHeight="280" SelectionMode="None" Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DownloadItem">
                                        <Grid Padding="6,8" Margin="0,2" CornerRadius="6"
                                              Background="{ThemeResource SubtleFillColorTransparentBrush}" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="16" Opacity="0.8" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind FileName}" FontSize="13" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- İndirilirken Boyut & Canlı İlerleme Çubuğu -->
                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Opacity="0.6"
                                                           Visibility="{x:Bind IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}" Maximum="100" Height="3"
                                                             Foreground="#0078D4" Margin="0,2,0,0"
                                                             Visibility="{x:Bind IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <!-- Tamamlandığında Dosyayı Aç Bağlantısı -->
                                                <Button Content="Dosyayı aç" Click="OpenFile_Click" Tag="{x:Bind FilePath}"
                                                        Visibility="{x:Bind IsDownloading, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        Foreground="#0078D4" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Button Width="26" Height="26" Padding="0" ToolTipService.ToolTip="Klasörde göster"
                                                        Click="ShowInFolder_Click" Tag="{x:Bind FilePath}" Background="Transparent" BorderThickness="0">
                                                    <FontIcon Glyph="&#xED25;" FontSize="11" />
                                                </Button>
                                                <Button Width="26" Height="26" Padding="0" ToolTipService.ToolTip="Kaldır"
                                                        Click="DeleteDownload_Click" Tag="{x:Bind Id}" Background="Transparent" BorderThickness="0">
                                                    <FontIcon Glyph="&#xE711;" FontSize="11" Opacity="0.6" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <!-- Alt Kısım: Tümünü Gör (bear://downloads) -->
                        <Button Grid.Row="2" Content="Daha fazla göster" HorizontalAlignment="Stretch"
                                Click="OpenAllDownloadsPage_Click" />
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- 7. Uzantılar / Eklentiler Butonu (Edge Stili Puzzle İkonu) -->
        <Button x:Name="ExtensionsButton" Grid.Column="7" Width="36" Height="36" Padding="0"
                ToolTipService.ToolTip="Uzantılar" Click="ExtensionsButton_Click">
            <FontIcon Glyph="&#xE74C;" FontSize="14" />
            <Button.Flyout>
                <Flyout x:Name="ExtensionsFlyout" Placement="BottomEdgeAlignedRight" Opening="ExtensionsFlyout_Opening">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="14,12,14,12" />
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="MinWidth" Value="320" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <Grid Width="310" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Başlık ve Kapat Butonu -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74C;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="FlyoutExtensionsTitleText" Text="Uzantılar" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Width="26" Height="26" Padding="0" CornerRadius="4" HorizontalAlignment="Right"
                                    Background="Transparent" BorderThickness="0"
                                    Click="CloseExtensionsFlyout_Click"
                                    ToolTipService.ToolTip="Kapat">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </Grid>

                        <!-- Yüklü Eklentiler Listesi -->
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="EmptyExtensionsText" Text="Henüz yüklü bir uzantı yok"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.5" FontSize="12" Margin="0,14" />
                            <ListView x:Name="ExtensionsFlyoutListView" SelectionMode="None" MaxHeight="260" Padding="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="6,4,6,4" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MinHeight" Value="42" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ExtensionInfo">
                                        <Grid Height="42" ColumnSpacing="12" Padding="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE74C;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                                <Image Source="{x:Bind IconPath, Mode=OneWay}" Width="24" Height="24" Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="" OffContent=""
                                                          MinWidth="0" Margin="0" VerticalAlignment="Center"
                                                          Toggled="FlyoutExtensionToggle_Toggled" Tag="{x:Bind Id}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Alt Aksiyonlar: Yönetim ve Chrome Mağazası (Edge Stili) -->
                        <StackPanel Grid.Row="2" Spacing="2">
                            <MenuFlyoutSeparator Margin="0,4,0,6" />
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,8"
                                    Background="Transparent" BorderThickness="0" CornerRadius="6"
                                    Click="OpenAllExtensionsPage_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                    <TextBlock x:Name="FlyoutManageExtensionsText" Text="Uzantıları yönet" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,8"
                                    Background="Transparent" BorderThickness="0" CornerRadius="6"
                                    Click="OpenChromeStore_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74C;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="FlyoutChromeStoreText" Text="Chrome Web Mağazası" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- 8. Profil Butonu -->
        <Button x:Name="ProfileButton" Grid.Column="8" Width="36" Height="36" Padding="0" 
                ToolTipService.ToolTip="Profil">
            <PersonPicture x:Name="NavProfilePic" Width="26" Height="26" />
            <Button.Flyout>
                <Flyout>
                    <StackPanel Spacing="10" Width="220" Margin="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <PersonPicture x:Name="FlyoutProfilePic" Width="40" Height="40" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="FlyoutProfileName" Text="Kullanıcı 1" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="FlyoutProfileOfflineText" Text="Yerel Profil (Çevrimdışı)" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>
                        <MenuFlyoutSeparator />
                        <Button x:Name="ManageProfileBtn" Content="Profili Yönet" HorizontalAlignment="Stretch" Click="ManageProfileButton_Click" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- 8. Edge Stili Üç Nokta (...) Menüsü -->
        <Button x:Name="MoreMenuButton" Grid.Column="9" Width="36" Height="36" Padding="0" 
                ToolTipService.ToolTip="Ayarlar ve daha fazlası">
            <FontIcon Glyph="&#xE712;" FontSize="14" />
            <Button.Flyout>
                <MenuFlyout x:Name="MoreMenuFlyout" Placement="BottomEdgeAlignedRight" Closing="MoreMenuFlyout_Closing">

                    <!-- BÖLÜM 1: Sekmeler & Pencereler -->
                    <MenuFlyoutItem x:Name="MenuNewTabItem" Text="Yeni sekme" Tag="NewTab" KeyboardAcceleratorTextOverride="Ctrl+T" Click="MenuItem_Action_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE710;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuNewWindowItem" Text="Yeni pencere" Tag="NewWindow" KeyboardAcceleratorTextOverride="Ctrl+N" Click="MenuItem_Action_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE78B;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuNewInPrivateItem" Text="Yeni InPrivate penceresi" Tag="NewInPrivate" KeyboardAcceleratorTextOverride="Ctrl+Shift+N" Click="MenuItem_Action_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE727;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <!-- BÖLÜM 2: EDGE STİLİ BİREBİR YAKINLAŞTIRMA SATIRI -->
                    <MenuFlyoutItem x:Name="ZoomRowItem">
                        <MenuFlyoutItem.Template>
                            <ControlTemplate TargetType="MenuFlyoutItem">
                                <Grid Height="38" Padding="12,0,8,0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Sol: Büyüteç ve Yazı -->
                                    <FontIcon Grid.Column="0" Glyph="&#xE71E;" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Yakınlaştır" VerticalAlignment="Center" FontSize="14" />

                                    <!-- Sağ: [ — ]  [%100]  [ + ]  [ ⤢ ] -->
                                    <Button x:Name="ZoomOutBtn" Grid.Column="2" Width="28" Height="28" Padding="0" 
                                            Background="Transparent" BorderThickness="0" CornerRadius="4"
                                            ToolTipService.ToolTip="Küçült" Click="ZoomOutBtn_Click">
                                        <FontIcon Glyph="&#xE738;" FontSize="11" />
                                    </Button>

                                    <TextBlock x:Name="ZoomPercentLabel" Grid.Column="3" Text="%100" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center" 
                                               Width="46" TextAlignment="Center" FontSize="13" />

                                    <Button x:Name="ZoomInBtn" Grid.Column="4" Width="28" Height="28" Padding="0" 
                                            Background="Transparent" BorderThickness="0" CornerRadius="4"
                                            ToolTipService.ToolTip="Büyüt" Click="ZoomInBtn_Click">
                                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                                    </Button>

                                    <Button x:Name="FullScreenBtn" Grid.Column="5" Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                                            Background="Transparent" BorderThickness="0" CornerRadius="4"
                                            ToolTipService.ToolTip="Tam ekran" Click="FullScreenBtn_Click">
                                        <FontIcon Glyph="&#xE740;" FontSize="13" />
                                    </Button>
                                </Grid>
                            </ControlTemplate>
                        </MenuFlyoutItem.Template>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <!-- BÖLÜM 3: Temel Tarayıcı Öğeleri -->
                    <MenuFlyoutItem x:Name="MenuFavoritesItem" Text="Sık kullanılanlar" Tag="Favorites" KeyboardAcceleratorTextOverride="Ctrl+Shift+O" Click="MenuItem_Action_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE734;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuHistoryItem" Text="Geçmiş" Tag="History" KeyboardAcceleratorTextOverride="Ctrl+H" Click="MenuItem_Action_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE81C;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuDownloadsItem" Text="İndirilenler" Tag="Downloads" KeyboardAcceleratorTextOverride="Ctrl+J" Click="MenuItem_Action_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem x:Name="MenuExtensionsSubItem" Text="Uzantılar">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xEA86;" />
                        </MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem x:Name="MenuManageExtensionsItem" Text="Uzantıları yönet" Tag="ManageExtensions" Click="MenuItem_Action_Click" />
                        <MenuFlyoutItem x:Name="MenuOpenExtensionStoreItem" Text="Chrome Web Mağazası" Tag="OpenExtensionStore" Click="MenuItem_Action_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem x:Name="MenuPasswordsItem" Text="Parolalar" Tag="Passwords" Click="MenuItem_Action_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8D7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem x:Name="MenuDevToolsItem" Text="Geliştirici araçları" Tag="DevTools" KeyboardAcceleratorTextOverride="F12" Click="MenuItem_Action_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xEC7A;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <!-- BÖLÜM 5: Sistem & Ayarlar -->
                    <MenuFlyoutItem x:Name="MenuSettingsItem" Text="Ayarlar" Tag="Settings" Click="MenuItem_Action_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem x:Name="MenuHelpSubItem" Text="Yardım ve geri bildirim">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE897;" />
                        </MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem x:Name="MenuAboutItem" Text="Bear Browser Hakkında" Tag="About" Click="MenuItem_Action_Click" />
                        <MenuFlyoutItem x:Name="MenuFeedbackItem" Text="Geri bildirim gönder" Tag="Feedback" Click="MenuItem_Action_Click" />
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSeparator />

                    <!-- BÖLÜM 6: Tarayıcıyı Kapat -->
                    <MenuFlyoutItem x:Name="MenuExitItem" Text="Bear Browser'ı Kapat" Tag="ExitApp" Click="MenuItem_Action_Click" />

                </MenuFlyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>