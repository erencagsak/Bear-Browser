<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bear_Browser.Controls.ExtensionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Bear_Browser.Models">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SOL BÖLME: MAĞAZALAR VE GELİŞTİRİCİ ARAÇLARI -->
        <Grid Grid.Column="0" Padding="18,24,14,18" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE74C;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Uzantılar" FontWeight="SemiBold" FontSize="18" />
                    <TextBlock Text="Eklenti Yöneticisi" FontSize="11" Opacity="0.6" />
                </StackPanel>
            </StackPanel>

            <!-- Arama Kutusu -->
            <TextBox x:Name="SearchBox" Grid.Row="1" Height="36" CornerRadius="6"
                     PlaceholderText="Yüklü uzantılarda ara..."
                     TextChanged="SearchBox_TextChanged" />

            <!-- Eklenti Mağazaları Kartı -->
            <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14,14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Eklenti Mağazaları" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Chrome ve Edge mağazalarındaki milyonlarca eklentiyi doğrudan Bear Browser'a ekleyebilirsiniz." FontSize="11" Opacity="0.75" TextWrapping="Wrap" />

                    <Button HorizontalAlignment="Stretch" Height="36" CornerRadius="6"
                            Click="OpenChromeWebStore_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE774;" FontSize="13" />
                            <TextBlock Text="Chrome Web Mağazası" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button HorizontalAlignment="Stretch" Height="36" CornerRadius="6"
                            Click="OpenEdgeAddons_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE774;" FontSize="13" />
                            <TextBlock Text="Microsoft Edge Eklentileri" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Geliştirici Modu & Yerel Yükleme -->
            <Border Grid.Row="3" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14,14">
                <StackPanel Spacing="10">
                    <Grid>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Geliştirici Modu" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Yerel klasörden eklenti yükleyin" FontSize="11" Opacity="0.7" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DevModeToggle" HorizontalAlignment="Right" OnContent="" OffContent="" Toggled="DevModeToggle_Toggled" />
                    </Grid>

                    <Button x:Name="LoadUnpackedBtn" HorizontalAlignment="Stretch" Height="36" CornerRadius="6"
                            Visibility="Collapsed" Click="LoadUnpackedBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xED25;" FontSize="13" />
                            <TextBlock Text="Paketlenmemiş eklenti yükle" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DİKEY AYIRICI ÇİZGİ -->
        <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- SAĞ BÖLME: YÜKLÜ EKLENTİLER LİSTESİ -->
        <Grid Grid.Column="2" Padding="28,24,28,20" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık ve Sayaç -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Yüklü Uzantılar" FontWeight="SemiBold" FontSize="20" />
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="ExtensionsCountBadge" Text="0 eklenti" FontSize="12" FontWeight="Medium" Opacity="0.8" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- BOŞ DURUM EKRANI (HENÜZ EKLENTİ YOKSA) -->
            <Border x:Name="EmptyStateBorder" Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="36" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="440">
                    <Border Width="64" Height="64" CornerRadius="16" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE74C;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Henüz hiçbir uzantı yüklenmedi" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Google Chrome Web Mağazası veya Microsoft Edge Eklentileri sayfalarından dilediğiniz eklentiyi tek tıkla Bear Browser'a ekleyebilirsiniz."
                               FontSize="13" Opacity="0.75" TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Style="{ThemeResource AccentButtonStyle}" Height="36" CornerRadius="6" Click="OpenChromeWebStore_Click">
                            <TextBlock Text="Chrome Mağazasını Aç" />
                        </Button>
                        <Button Height="36" CornerRadius="6" Click="OpenEdgeAddons_Click">
                            <TextBlock Text="Edge Eklentilerini Aç" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- EKLENTİLER LİSTESİ -->
            <ScrollViewer Grid.Row="1">
                <ItemsControl x:Name="ExtensionsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ExtensionInfo">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- İkon -->
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Top">
                                        <Grid>
                                            <FontIcon Glyph="&#xE74C;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{x:Bind IconPath, Mode=OneWay}" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Bilgiler -->
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Version, Mode=OneWay}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Source, Mode=OneWay}" FontSize="10" Opacity="0.75" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        
                                        <TextBlock Text="{x:Bind Id, Mode=OneWay}" FontSize="10" Opacity="0.4" FontFamily="Consolas" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Aksiyonlar: Toggle & Sil -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" Toggled="ExtensionToggle_Toggled" Tag="{x:Bind Id}" />

                                        <Button Width="36" Height="36" Padding="0" CornerRadius="6"
                                                ToolTipService.ToolTip="Uzantıyı Kaldır" Click="RemoveExtension_Click" Tag="{x:Bind Id}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#E81123" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
